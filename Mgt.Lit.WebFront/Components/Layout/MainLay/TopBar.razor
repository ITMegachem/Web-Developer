@inject Mgt.Lit.WebFront.Auth.AuthState AuthState
@inject Mgt.Lit.WebFront.Services.AuthService Auth
@inject NavigationManager Nav
@inject Mgt.Lit.WebFront.Services.UiState UiState

<div class="topbar-container d-flex align-items-center justify-content-between px-4">
    <div class="search-group d-flex align-items-center">
        <div class="search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Search data..." />
        </div>
    </div>

    <div class="topbar-right d-flex align-items-center gap-4">
        <div class="theme-toggle"><i class="bi bi-moon-fill opacity-50"></i></div>
        <div class="notifications position-relative">
            <i class="bi bi-bell-fill opacity-50"></i>
            <span class="notification-badge"></span>
        </div>

        <div class="dropdown">
            <button class="user-profile-card d-flex align-items-center border-0 bg-transparent p-0"
                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="user-info text-end me-3 d-none d-md-block">
                    <div class="user-fullname">@(AuthState.User?.FindFirst("FullName")?.Value ?? "Kamonwan Anan")</div>
                    <div class="user-role-label text-success">@(IsAdmin ? "Administrator" : "User")</div>
                </div>
                <div class="avatar-box-green">
                    @(GetInitials(AuthState.User?.FindFirst("FullName")?.Value ?? "Kamonwan Anan"))
                </div>
            </button>

            <ul class="dropdown-menu dropdown-menu-end premium-dropdown shadow border-0 mt-3">
                <li class="px-3 py-2 d-md-none border-bottom mb-2">
                    <div class="fw-bold">@(AuthState.User?.FindFirst("FullName")?.Value)</div>
                    <div class="small text-success">Admin</div>
                </li>
                <li><a class="dropdown-item" href="#">@T("NewProject")</a></li>
                @if (IsAdmin)
                {
                    <li><a class="dropdown-item" href="/settings"><i class="bi bi-gear me-2"></i>@T("Settings")</a></li>
                    <li><a class="dropdown-item" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>@T("Admin Dashboard")</a></li>
                    <li><a class="dropdown-item" href="/admin/activity"><i class="bi bi-list-check me-2"></i>@T("Activity Log")</a></li>
                    <li><a class="dropdown-item" href="/admin/errors"><i class="bi bi-exclamation-triangle me-2"></i>@T("Error Log")</a></li>
                    <li><a class="dropdown-item" href="/admin/monitoring"><i class="bi bi-cpu me-2"></i>@T("Monitoring")</a></li>
                }
                <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>@T("Profile")</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><button class="dropdown-item text-danger" @onclick="Logout"><i class="bi bi-box-arrow-right me-2"></i>@T("SignOut")</button></li>
            </ul>
        </div>
    </div>
</div>

@code {
    private bool IsAdmin =>
        string.Equals(
            AuthState.User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value,
            "admin",
            StringComparison.OrdinalIgnoreCase
        );

    private string GetInitials(string fullName) =>
        string.Concat(fullName.Split(' ').Select(n => n[0])).ToUpper();

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    private string T(string key) =>
        (Text.TryGetValue(UiState.Lang ?? "th", out var dict) && dict.TryGetValue(key, out var value)) ? value : key;

    private static readonly Dictionary<string, Dictionary<string, string>> Text = new()
    {
        ["en"] = new() { ["NewProject"] = "New Project", ["Settings"] = "Settings", ["SignOut"] = "Sign Out" /* ...เพิ่มตามเดิม */ },
        ["th"] = new() { ["NewProject"] = "โปรเจกต์ใหม่", ["Settings"] = "ตั้งค่า", ["SignOut"] = "ออกจากระบบ" /* ...เพิ่มตามเดิม */ }
    };
}