@page "/forecast-monthly"
@using Mgt.Lit.WebFront.Components.Layout.MainLay
@layout AppLayout
@rendermode InteractiveServer
<link rel="stylesheet" href="/lib/bootstrap/dist/css/dash-theme.css" />
@using System.Linq
@using ClosedXML.Excel
@using Microsoft.JSInterop
@using Mgt.Lit.Core.DTOs.DashBoard
@using Mgt.Lit.WebFront.Services.DashBoard
@using Mgt.Lit.WebFront.Components
@inject DashForecastMonthlyApiService ForecastApi
@inject Mgt.Lit.WebFront.Auth.AuthState AuthState
@inject DownloadLogService DownloadLogSvc
@inject IJSRuntime JS
@implements IAsyncDisposable

<style>
    /* ── Forecast Monthly Report — สไตล์เฉพาะหน้านี้ (คำนำหน้า fmr-) ───── */
    .fmr-btn {
        font-weight: 600;
        font-size: 13px;
        padding: 9px 18px;
        border-radius: 10px;
        white-space: nowrap;
        border: 1px solid var(--card-border);
    }
    .fmr-btn-primary { background: var(--brand-dark); color: #fff; border-color: var(--brand-dark); }
    .fmr-btn-primary:hover { opacity: 0.92; }
    .fmr-btn-secondary { background: #fff; color: var(--neutral-700); }
    .fmr-btn-secondary:hover { background: var(--neutral-100); }
    .fmr-btn-export { background: #15803d; color: #fff; border-color: #15803d; }
    .fmr-btn-export:hover { opacity: 0.92; }

    .fmr-toolbar { display: flex; justify-content: flex-end; gap: 10px; margin-bottom: 14px; }

    .fmr-kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 16px; }
    .fmr-kpi { background: var(--surface); border: 1px solid var(--card-border); border-radius: 12px; padding: 14px 16px; }
    .fmr-kpi-label { font-size: 12.5px; font-weight: 600; color: var(--neutral-700); margin-bottom: 6px; }
    .fmr-kpi-value { font-size: 24px; font-weight: 800; color: var(--brand-dark); line-height: 1.2; margin-bottom: 4px; }
    .fmr-kpi-value.danger { color: #b91c1c; }
    .fmr-kpi-sub { font-size: 11.5px; color: var(--muted); }

    .fmr-table-wrap table { border-collapse: separate; border-spacing: 0; }
    .fmr-table-wrap th, .fmr-table-wrap td { white-space: nowrap; text-align: right; }
    .fmr-table-wrap th:nth-child(1), .fmr-table-wrap td:nth-child(1),
    .fmr-table-wrap th:nth-child(2), .fmr-table-wrap td:nth-child(2),
    .fmr-table-wrap th:nth-child(3), .fmr-table-wrap td:nth-child(3) { text-align: left; }

    .fmr-group-forecast { background: #fdecea; color: #b91c1c; text-align: center; font-weight: 700; }
    .fmr-group-stock { background: #dcfce7; color: #15803d; text-align: center; font-weight: 700; }
    .fmr-onhand-cell { background: #fffbeb; }
    .fmr-shortage { color: #b91c1c; font-weight: 700; }
    .fmr-total-row td { font-weight: 700; border-top: 2px solid var(--card-border); background: #eef6fb; }

    .fmr-note { font-size: 12px; color: var(--muted); margin-top: 4px; }

    @@media (max-width: 1400px) { .fmr-kpi-row { grid-template-columns: repeat(2, 1fr); } }
</style>

<div class="dash-bg">
    <div class="dash-page">
        @if (_loading)
        {
            <div class="dash-overlay"><span class="dash-spinner"></span></div>
        }
        <div class="dash-top">
            <div>
                <div class="dash-eyebrow">Management Report</div>
                <div class="dash-title">Forecast Monthly Report</div>
                <div class="dash-subtitle">Based on Zoho CRM Deals &amp; SAP Stock — As of @DateTime.Now.ToString("dd MMM yyyy")</div>
            </div>
        </div>

        <div class="dash-filters dash-filter-panel">
            <div class="dash-field">
                <div class="dash-field-label">Customer</div>
                <DashSelect @bind-Value="_selectedCustomer" Placeholder="All Customers" Options="@(_data?.AvailableCustomers ?? new())" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Material Group</div>
                <DashSelect @bind-Value="_selectedMaterialGroup" Placeholder="All" Options="@(_data?.AvailableMaterialGroups ?? new())" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Material</div>
                <DashSelect @bind-Value="_selectedMaterial" Placeholder="All" Options="@(_data?.AvailableMaterials ?? new())" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Job Deal (Zoho)</div>
                <DashSelect @bind-Value="_selectedJobDeal" Placeholder="All" Options="@(_data?.AvailableJobDeals ?? new())" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">From Month</div>
                <input type="month" class="dash-input" value="@_fromMonthText" @onchange="@((ChangeEventArgs e) => _fromMonthText = e.Value?.ToString() ?? _fromMonthText)" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">To Month</div>
                <input type="month" class="dash-input" value="@_toMonthText" @onchange="@((ChangeEventArgs e) => _toMonthText = e.Value?.ToString() ?? _toMonthText)" />
            </div>
        </div>

        <div class="fmr-toolbar">
            <button type="button" class="fmr-btn fmr-btn-secondary" @onclick="ResetAsync">↺ Reset</button>
            <button type="button" class="fmr-btn fmr-btn-primary" @onclick="SearchAsync">🔍 Search</button>
            <button type="button" class="fmr-btn fmr-btn-export" @onclick="ExportToExcelAsync" disabled="@(_data is null || _data.Rows.Count == 0)">⬇ Export Excel</button>
        </div>

        @if (_data is null)
        {
            <div class="dash-loading" role="status">
                <span class="dash-spinner" aria-hidden="true"></span>
                <span>Loading forecast data</span>
            </div>
        }
        else
        {
            var kpi = _data.Kpi;

            <div class="fmr-kpi-row">
                <div class="fmr-kpi">
                    <div class="fmr-kpi-label">Total Forecast Qty</div>
                    <div class="fmr-kpi-value">@kpi.TotalForecastQty.ToString("N0")</div>
                    <div class="fmr-kpi-sub">KG, from Zoho CRM Job Deals</div>
                </div>
                <div class="fmr-kpi">
                    <div class="fmr-kpi-label">On Hand Qty (SAP)</div>
                    <div class="fmr-kpi-value">@kpi.OnHandQty.ToString("N0")</div>
                    <div class="fmr-kpi-sub">@kpi.MaterialsWithStockDataCount of @kpi.MaterialsCount materials matched in SAP</div>
                </div>
                <div class="fmr-kpi">
                    <div class="fmr-kpi-label">Shortage Qty</div>
                    <div class="fmr-kpi-value @(kpi.ShortageQty > 0 ? "danger" : "")">@kpi.ShortageQty.ToString("N0")</div>
                    <div class="fmr-kpi-sub">Forecast − On Hand (Incoming PO not included)</div>
                </div>
                <div class="fmr-kpi">
                    <div class="fmr-kpi-label">Materials</div>
                    <div class="fmr-kpi-value">@kpi.MaterialsCount</div>
                    <div class="fmr-kpi-sub">Items with forecast in range</div>
                </div>
            </div>

            <div class="dash-card">
                <div class="dash-card-header">Forecast vs Stock by Material</div>
                <div class="dash-card-body">
                    <div class="table-scroll fmr-table-wrap">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th rowspan="2">No.</th>
                                    <th rowspan="2">Material Code</th>
                                    <th rowspan="2">Material Description</th>
                                    <th class="fmr-group-forecast" colspan="@_data.MonthLabels.Count">Forecast (Zoho CRM - Job Deals)</th>
                                    <th class="fmr-group-stock" rowspan="2">On Hand Qty (SAP)</th>
                                </tr>
                                <tr>
                                    @foreach (var label in _data.MonthLabels)
                                    {
                                        <th class="fmr-group-forecast">@label</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (_data.Rows.Count == 0)
                                {
                                    <tr><td colspan="@(4 + _data.MonthLabels.Count)" class="dash-table-empty">No forecast data for this filter</td></tr>
                                }
                                else
                                {
                                    @for (var i = 0; i < _data.Rows.Count; i++)
                                    {
                                        var row = _data.Rows[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>@row.MaterialCode</td>
                                            <td>@row.MaterialDescription</td>
                                            @foreach (var qty in row.MonthlyQty)
                                            {
                                                <td>@(qty == 0 ? "-" : qty.ToString("N0"))</td>
                                            }
                                            <td class="fmr-onhand-cell @(row.IsShortage ? "fmr-shortage" : "")">
                                                @(row.OnHandQty.HasValue ? row.OnHandQty.Value.ToString("N0") : "N/A")
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (_data.Rows.Count > 0)
                            {
                                <tfoot>
                                    <tr class="fmr-total-row">
                                        <td colspan="3">Total (KG)</td>
                                        @for (var m = 0; m < _data.MonthLabels.Count; m++)
                                        {
                                            var monthIndex = m;
                                            <td>@_data.Rows.Sum(r => r.MonthlyQty[monthIndex]).ToString("N0")</td>
                                        }
                                        <td>@_data.Rows.Where(r => r.OnHandQty.HasValue).Sum(r => r.OnHandQty!.Value).ToString("N0")</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>

            <div class="fmr-note">
                Note: 1. Forecast data from Zoho CRM (Deal_Items). Forecast month uses the line's own Required Date when set —
                most lines don't have it filled in, so the opportunity's expected Closing Date is used as a fallback.
                2. On Hand Qty is a live lookup from SAP (API_MATERIAL_STOCK_SRV) per Material Code — "N/A" means the material
                could not be matched in SAP, not that stock is zero. 3. Incoming PO / incoming shipments are not yet wired to a
                confirmed data source and are not included in this report or the Shortage calculation. 4. Qty unit = KG.
                Generated on @DateTime.Now.ToString("dd MMM yyyy HH:mm").
            </div>
        }
    </div>
</div>

@code {
    private ForecastMonthlyDto? _data;
    private bool _loading;

    private string _selectedCustomer = "";
    private string _selectedMaterialGroup = "";
    private string _selectedMaterial = "";
    private string _selectedJobDeal = "";
    private string _fromMonthText = DateTime.Now.ToString("yyyy-MM");
    private string _toMonthText = DateTime.Now.AddMonths(5).ToString("yyyy-MM");

    private IJSObjectReference? _jsModule;

    private ForecastMonthlyFilter BuildFilter() => new()
    {
        FromMonth = ParseMonth(_fromMonthText),
        ToMonth = ParseMonth(_toMonthText),
        CustomerName = string.IsNullOrWhiteSpace(_selectedCustomer) ? null : _selectedCustomer,
        MaterialGroup = string.IsNullOrWhiteSpace(_selectedMaterialGroup) ? null : _selectedMaterialGroup,
        // ตัวเลือกในดรอปดาวน์แสดงเป็น "Code - Description" แต่ filter ต้องส่งแค่ Material Code
        MaterialCode = string.IsNullOrWhiteSpace(_selectedMaterial) ? null : _selectedMaterial.Split(" - ")[0],
        JobDeal = string.IsNullOrWhiteSpace(_selectedJobDeal) ? null : _selectedJobDeal
        // SalesGroup: server บังคับตาม BU ของ user
    };

    private static DateTime? ParseMonth(string text) =>
        DateTime.TryParseExact(text, "yyyy-MM", null, System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(AuthState.Token))
            await AuthState.InitializeAsync();

        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            _data = await ForecastApi.GetAsync(BuildFilter());
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResetAsync()
    {
        _selectedCustomer = "";
        _selectedMaterialGroup = "";
        _selectedMaterial = "";
        _selectedJobDeal = "";
        _fromMonthText = DateTime.Now.ToString("yyyy-MM");
        _toMonthText = DateTime.Now.AddMonths(5).ToString("yyyy-MM");
        await SearchAsync();
    }

    private async Task ExportToExcelAsync()
    {
        if (_data is null || _data.Rows.Count == 0) return;

        try
        {
            var username = AuthState.Permission?.Username;
            var fileName = $"ForecastMonthlyReport_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await DownloadLogSvc.LogDownloadAsync(username ?? "", fileName);

            _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/site.js");

            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("Forecast Monthly");

            var headers = new List<string> { "No.", "Material Code", "Material Description" };
            headers.AddRange(_data.MonthLabels);
            headers.Add("On Hand Qty (SAP)");

            for (var i = 0; i < headers.Count; i++)
                ws.Cell(1, i + 1).Value = headers[i];

            var headerRow = ws.Row(1);
            headerRow.Style.Font.Bold = true;
            headerRow.Style.Fill.BackgroundColor = XLColor.LightGray;

            var row = 2;
            for (var i = 0; i < _data.Rows.Count; i++)
            {
                var r = _data.Rows[i];
                var col = 1;
                ws.Cell(row, col++).Value = i + 1;
                ws.Cell(row, col++).Value = r.MaterialCode;
                ws.Cell(row, col++).Value = r.MaterialDescription;
                foreach (var qty in r.MonthlyQty)
                    ws.Cell(row, col++).Value = qty;
                if (r.OnHandQty.HasValue)
                    ws.Cell(row, col++).Value = r.OnHandQty.Value;
                else
                    ws.Cell(row, col++).Value = "N/A";
                row++;
            }

            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());

            await _jsModule.InvokeVoidAsync(
                "downloadFileFromBytes",
                fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            try { await _jsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
