@page "/customer-churn-analysis"
@using Mgt.Lit.WebFront.Components.Layout.MainLay
@layout AppLayout
@rendermode InteractiveServer
<link rel="stylesheet" href="/lib/bootstrap/dist/css/dash-theme.css?v=20260909a" />
@using System.Linq
@using Microsoft.JSInterop
@using Mgt.Lit.Core.DTOs.DashBoard
@using Mgt.Lit.WebFront.Services.DashBoard
@using Mgt.Lit.WebFront.Components
@using ClosedXML.Excel
@inject DashCustomerChurnAnalysisApiService ChurnApi
@inject Mgt.Lit.WebFront.Auth.AuthState AuthState
@inject DownloadLogService DownloadLogSvc
@inject IJSRuntime JS
@implements IAsyncDisposable

<style>
    /* ── Customer Churn Analysis Report — สไตล์เฉพาะหน้านี้ (คำนำหน้า cca-) ─────── */
    .cca-top-actions { display: flex; align-items: center; gap: 10px; }

    .cca-kpi-pill {
        background: #2f7cb0;
        color: #fff;
        font-weight: 700;
        font-size: 13px;
        padding: 10px 18px;
        border-radius: 10px;
        white-space: nowrap;
    }

    .cca-btn-export { background: #15803d; color: #fff; border: 1px solid #15803d; font-weight: 600; font-size: 13px; padding: 9px 16px; border-radius: 10px; white-space: nowrap; }
    .cca-btn-export:hover { opacity: 0.92; }
    .cca-btn-export:disabled { opacity: 0.5; cursor: not-allowed; }

    .cca-reset-btn {
        background: #fff;
        border: 1px solid var(--card-border);
        color: var(--neutral-700);
        font-weight: 600;
        font-size: 13px;
        padding: 9px 16px;
        border-radius: 10px;
        white-space: nowrap;
    }
    .cca-reset-btn:hover { background: var(--neutral-100); }

    .cca-kpi-row {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
        margin-bottom: 16px;
    }

    .cca-kpi {
        background: var(--surface);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 14px 16px;
    }

    .cca-kpi-label { font-size: 15px; font-weight: 600; color: var(--neutral-700); margin-bottom: 6px; }
    .cca-kpi-value { font-size: 30px; font-weight: 800; color: var(--brand-dark); line-height: 1.2; margin-bottom: 6px; }
    .cca-kpi-value.warn { color: #b45309; }
    .cca-kpi-value.danger { color: #be123c; }
    .cca-kpi-sub { font-size: 14px; color: var(--muted); }

    .cca-insight {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #eef6fb;
        border: 1px solid #cfe4f2;
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 16px;
        font-size: 13px;
        color: #1f2933;
    }

    .cca-insight-badge {
        background: #2f7cb0;
        color: #fff;
        font-weight: 700;
        font-size: 12px;
        padding: 6px 14px;
        border-radius: 999px;
        white-space: nowrap;
    }

    .cca-chart-row {
        display: grid;
        grid-template-columns: 1.1fr 1.1fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
        align-items: stretch;
    }

    .cca-table-row {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
        align-items: start;
    }

    .cca-bar-row { margin-bottom: 16px; }
    .cca-bar-label { display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
    .cca-bar-track { background: var(--neutral-100); border-radius: 8px; height: 14px; overflow: hidden; }
    .cca-bar-fill { height: 100%; border-radius: 8px; }
    .cca-bar-fill.existing { background: #2f7cb0; }
    .cca-bar-fill.new { background: #7cb342; }

    .cca-summary-box {
        background: var(--brand-soft);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 12.5px;
        color: var(--brand-dark);
        margin-top: 10px;
    }
    .cca-summary-box div + div { margin-top: 4px; }

    .cca-growth-bars { display: flex; align-items: flex-end; gap: 24px; height: 140px; margin: 10px 0; }
    .cca-growth-bar { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
    .cca-growth-bar-fill { width: 56px; border-radius: 6px 6px 0 0; }
    .cca-growth-bar-fill.ly { background: #98a2ae; }
    .cca-growth-bar-fill.cy { background: #e11d48; }
    .cca-growth-bar-value { font-size: 12.5px; font-weight: 700; margin-bottom: 4px; }
    .cca-growth-bar-label { font-size: 11.5px; color: var(--muted); margin-top: 6px; text-align: center; }

    .cca-growth-badge {
        text-align: center;
        background: #fee2e2;
        color: #b91c1c;
        border-radius: 10px;
        padding: 10px;
        font-size: 20px;
        font-weight: 800;
    }
    .cca-growth-badge.pos { background: #dcfce7; color: #15803d; }
    .cca-growth-badge-sub { font-size: 11px; font-weight: 500; color: var(--muted); margin-top: 2px; }

    .cca-risk-badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700; white-space: nowrap; }
    .cca-risk-badge.critical { background: #fee2e2; color: #b91c1c; }
    .cca-risk-badge.high { background: #ffedd5; color: #c2410c; }
    .cca-risk-badge.watch { background: #fef9c3; color: #a16207; }

    .cca-diff-pos { color: #15803d; font-weight: 600; }
    .cca-diff-neg { color: #b91c1c; font-weight: 600; }

    .cca-view-all { background: none; border: none; color: var(--brand-dark); font-weight: 600; font-size: 12.5px; padding: 8px 0 0; width: 100%; text-align: center; }
    .cca-view-all:hover { text-decoration: underline; }

    .cca-empty-panel { display: flex; align-items: center; justify-content: center; height: 100%; min-height: 180px; color: var(--muted); font-size: 12.5px; text-align: center; padding: 12px; }

    .cca-risk-total { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: var(--neutral-100); border-radius: 10px; font-weight: 700; font-size: 13px; margin-top: 8px; }

    .cca-note { font-size: 12px; color: var(--muted); margin-top: 4px; }

    @@media (max-width: 1400px) {
        .cca-kpi-row { grid-template-columns: repeat(3, 1fr); }
        .cca-chart-row { grid-template-columns: 1fr; }
        .cca-table-row { grid-template-columns: 1fr; }
    }
    @@media (max-width: 640px) {
        .cca-kpi-row { grid-template-columns: 1fr 1fr; }
    }
</style>

<div class="dash-bg">
    <div class="dash-page">
        @if (_loading)
        {
            <div class="dash-overlay"><span class="dash-spinner"></span></div>
        }
        <div class="dash-top">
            <div>
                <div class="dash-eyebrow">Management Report</div>
                <div class="dash-title">Customer Churn Analysis Report</div>
                <div class="dash-subtitle">Sold-to Party Base / Lost Sold-to Party / Existing vs New Revenue / Existing Sold-to Party Growth</div>
            </div>
            <div class="cca-top-actions">
                @if (CanExport)
                {
                    <button type="button" class="cca-btn-export" @onclick="ExportToExcelAsync" disabled="@(_data is null || _data.LostCustomers.Count == 0)">⬇ Export Excel</button>
                }
                <div class="cca-kpi-pill">Retention KPI</div>
            </div>
        </div>

        <div class="dash-filters dash-filter-panel">
            <div class="dash-field">
                <div class="dash-field-label">Year</div>
                <DashSelect @bind-Value="_selectedYear" @bind-Value:after="ReloadAsync"
                            Placeholder="All Years" Options="@_years.Select(y => y.ToString())" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Salesperson</div>
                <DashSelect @bind-Value="_selectedSalesperson" @bind-Value:after="ReloadAsync"
                            Placeholder="All" Options="@(_data?.AvailableSalesEmployees ?? new())" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Sold-to Party Group</div>
                <DashSelect @bind-Value="_selectedCustomerGroup" @bind-Value:after="ReloadAsync"
                            Placeholder="All" Options="@(_data?.AvailableCustomerGroups ?? new())" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Industry</div>
                <DashSelect @bind-Value="_selectedIndustry" @bind-Value:after="ReloadAsync"
                            Placeholder="All" Options="@(_data?.AvailableIndustries ?? new())" />
            </div>
            <div class="dash-field" style="align-self:flex-end">
                <button type="button" class="cca-reset-btn" @onclick="ResetAsync">↺ Reset</button>
            </div>
        </div>

        @if (_data is null)
        {
            <div class="dash-loading" role="status">
                <span class="dash-spinner" aria-hidden="true"></span>
                <span>Loading churn analysis data</span>
            </div>
        }
        else
        {
            var kpi = _data.Kpi;

            <div class="cca-kpi-row">
                <div class="cca-kpi">
                    <div class="cca-kpi-label">Existing Sold-to Parties</div>
                    <div class="cca-kpi-value">@kpi.ExistingCustomers</div>
                    <div class="cca-kpi-sub">Sold-to party base at start of period</div>
                </div>
                <div class="cca-kpi">
                    <div class="cca-kpi-label">Lost Sold-to Parties</div>
                    <div class="cca-kpi-value danger">@kpi.LostCustomers</div>
                    <div class="cca-kpi-sub">Churn @kpi.ChurnRatePercent.ToString("0.0")%</div>
                </div>
                <div class="cca-kpi">
                    <div class="cca-kpi-label">Retention Rate</div>
                    <div class="cca-kpi-value">@kpi.RetentionRatePercent.ToString("0.0")%</div>
                    <div class="cca-kpi-sub">Existing customers retained</div>
                </div>
                <div class="cca-kpi">
                    <div class="cca-kpi-label">Churn Rate</div>
                    <div class="cca-kpi-value danger">@kpi.ChurnRatePercent.ToString("0.0")%</div>
                    <div class="cca-kpi-sub">Annual customer churn</div>
                </div>
                <div class="cca-kpi">
                    <div class="cca-kpi-label">Existing Revenue</div>
                    <div class="cca-kpi-value">@FormatCompact(kpi.ExistingRevenue)</div>
                    <div class="cca-kpi-sub">Revenue from existing base</div>
                </div>
                <div class="cca-kpi">
                    <div class="cca-kpi-label">Existing Growth</div>
                    <div class="cca-kpi-value @(kpi.ExistingGrowthPercent >= 0 ? "" : "danger")">@(kpi.ExistingGrowthPercent >= 0 ? "+" : "")@kpi.ExistingGrowthPercent.ToString("0.0")%</div>
                    <div class="cca-kpi-sub">vs same period last year</div>
                </div>
            </div>

            <div class="cca-insight">
                <span class="cca-insight-badge">Summary</span>
                <span>@InsightText</span>
            </div>

            <div class="cca-chart-row">
                <div class="dash-card">
                    <div class="dash-card-header">Sold-to Party Base Breakdown</div>
                    <div class="dash-card-body">
                        <div id="@BaseDonutChartId" class="echarts-host" role="img" aria-label="Sold-to party base breakdown donut chart"></div>
                    </div>
                </div>
                <div class="dash-card">
                    <div class="dash-card-header">Revenue: Existing vs New</div>
                    <div class="dash-card-body">
                        <div class="cca-bar-row">
                            <div class="cca-bar-label"><span>Existing Revenue</span><span>@FormatCompact(kpi.ExistingRevenue)</span></div>
                            <div class="cca-bar-track"><div class="cca-bar-fill existing" style="width:@(kpi.ExistingRevenueSharePercent)%"></div></div>
                        </div>
                        <div class="cca-bar-row">
                            <div class="cca-bar-label"><span>New Revenue</span><span>@FormatCompact(kpi.NewRevenue)</span></div>
                            <div class="cca-bar-track"><div class="cca-bar-fill new" style="width:@(100 - kpi.ExistingRevenueSharePercent)%"></div></div>
                        </div>
                        <div class="cca-summary-box">
                            <div>Existing Revenue Share = @kpi.ExistingRevenueSharePercent.ToString("0.0")%</div>
                            <div>Total Revenue = @FormatCompact(kpi.TotalRevenue)</div>
                        </div>
                    </div>
                </div>
                <div class="dash-card">
                    <div class="dash-card-header">Existing Sold-to Party Growth</div>
                    <div class="dash-card-body">
                        <div class="cca-growth-bars">
                            <div class="cca-growth-bar">
                                <div class="cca-growth-bar-value">@FormatCompact(kpi.PreviousExistingRevenue)</div>
                                <div class="cca-growth-bar-fill ly" style="height:@(GrowthBarHeight(kpi.PreviousExistingRevenue, kpi))px"></div>
                                <div class="cca-growth-bar-label">Last Year (@(int.Parse(_selectedYear.Length > 0 ? _selectedYear : DateTime.Now.Year.ToString()) - 1))</div>
                            </div>
                            <div class="cca-growth-bar">
                                <div class="cca-growth-bar-value">@FormatCompact(kpi.ExistingRevenue)</div>
                                <div class="cca-growth-bar-fill cy" style="height:@(GrowthBarHeight(kpi.ExistingRevenue, kpi))px"></div>
                                <div class="cca-growth-bar-label">This Year (@(_selectedYear.Length > 0 ? _selectedYear : DateTime.Now.Year.ToString()))</div>
                            </div>
                        </div>
                        <div class="cca-growth-badge @(kpi.ExistingGrowthPercent >= 0 ? "pos" : "")">
                            @(kpi.ExistingGrowthPercent >= 0 ? "+" : "")@kpi.ExistingGrowthPercent.ToString("0.0")%
                            <div class="cca-growth-badge-sub">vs existing revenue last year</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cca-chart-row">
                <div class="dash-card">
                    <div class="dash-card-header">Churn Rate Trend</div>
                    <div class="dash-card-body">
                        <div id="@TrendChartId" class="echarts-host" role="img" aria-label="Monthly churn rate trend"></div>
                    </div>
                </div>
                <div class="dash-card">
                    <div class="dash-card-header">Churn by Industry (Top 6)</div>
                    <div class="dash-card-body">
                        @if (_data.ChurnByIndustry.Count == 0)
                        {
                            <div class="cca-empty-panel">No existing-customer data for this filter</div>
                        }
                        else
                        {
                            <div id="@IndustryChartId" class="echarts-host" role="img" aria-label="Churn rate by industry"></div>
                        }
                    </div>
                </div>
                <div class="dash-card">
                    <div class="dash-card-header">Churn Reason</div>
                    <div class="dash-card-body">
                        <div class="cca-empty-panel">Churn reason is not captured in the source data (would require a CRM exit-survey / reason-code field)</div>
                    </div>
                </div>
            </div>

            <div class="cca-table-row">
                <div class="dash-card">
                    <div class="dash-card-header d-flex justify-content-between align-items-center">
                        <span>Lost Sold-to Parties List (Churn)</span>
                        <span style="font-weight:600;font-size:12.5px;color:var(--muted)">Total Lost Sold-to Parties: @_data.LostCustomers.Count</span>
                    </div>
                    <div class="dash-card-body">
                        <div class="table-scroll">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Sold-to Party Code</th>
                                        <th>Sold-to Party Name</th>
                                        <th>Industry</th>
                                        <th>Salesperson</th>
                                        <th>Last Purchase</th>
                                        <th>Days</th>
                                        <th>Risk Level</th>
                                        <th>Last 12M Revenue</th>
                                        <th>Last 12M GP</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var visibleLost = _showAllLost ? _data.LostCustomers : _data.LostCustomers.Take(10).ToList(); }
                                    @if (visibleLost.Count == 0)
                                    {
                                        <tr><td colspan="10" class="dash-table-empty">No lost sold-to parties for this filter</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in visibleLost)
                                        {
                                            <tr>
                                                <td>@row.CustomerCode</td>
                                                <td>@row.CustomerName</td>
                                                <td>@row.IndustryName</td>
                                                <td>@row.SalesEmployeeBP</td>
                                                <td>@row.LastPurchaseDate.ToString("dd MMM yyyy")</td>
                                                <td>@row.DaysSinceLastPurchase</td>
                                                <td><span class="cca-risk-badge @(row.RiskLevel.ToLowerInvariant())">@row.RiskLevel</span></td>
                                                <td>@row.Last12MRevenue.ToString("N0")</td>
                                                <td>@row.Last12MGrossProfit.ToString("N0")</td>
                                                <td>@row.Action</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (_data.LostCustomers.Count > 10)
                        {
                            <button type="button" class="cca-view-all" @onclick="() => _showAllLost = !_showAllLost">
                                @(_showAllLost ? "Show Less" : $"View All Lost Sold-to Parties ({_data.LostCustomers.Count})")
                            </button>
                        }
                    </div>
                </div>

                <div class="dash-card">
                    <div class="dash-card-header">Risk Summary</div>
                    <div class="dash-card-body">
                        @if (_data.RiskSummary.Count == 0)
                        {
                            <div class="cca-empty-panel">No at-risk customers for this filter</div>
                        }
                        else
                        {
                            @foreach (var r in _data.RiskSummary)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="cca-risk-badge @(r.RiskLevel.ToLowerInvariant())">@r.RiskLevel</span>
                                    <span style="font-size:12.5px">@r.CustomerCount customers</span>
                                    <span style="font-size:12.5px;font-weight:600">@FormatCompact(r.RevenueAtRisk) (@r.SharePercent.ToString("0.0")%)</span>
                                </div>
                            }
                            <div class="cca-risk-total">
                                <span>Lost Revenue (12M)</span>
                                <span>@FormatCompact(_data.Kpi.LostRevenue)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="cca-note">
                Note: Existing Sold-to Party = first purchase before the start of the selected year. New Sold-to Party = first purchase within the selected year.
                Lost/Churn Sold-to Party = Existing sold-to party with no purchase for ≥365 days as of @_data.AsOfDate.ToString("d MMM yyyy").
                Last 12M Revenue/GP is measured in the 12 months up to each sold-to party's own last purchase date. Data from SAP Billing Document.
            </div>
        }
    </div>
</div>

@code {
    private CustomerChurnAnalysisDto? _data;
    private bool _loading;
    private bool _chartsNeedRender;
    private bool _showAllLost;

    private string _selectedYear = DateTime.Now.Year.ToString();
    private string _selectedSalesperson = "";
    private string _selectedCustomerGroup = "";

    private bool CanExport => Mgt.Lit.WebFront.Auth.ReportAccessHelper.CanExportReport(AuthState.User, "CustomerChurnAnalysis");
    private IJSObjectReference? _jsModule;
    private string _selectedIndustry = "";

    private const string BaseDonutChartId = "cca-base-donut";
    private const string TrendChartId = "cca-trend";
    private const string IndustryChartId = "cca-industry";

    private readonly List<int> _years =
        Enumerable.Range(DateTime.Now.Year - 5, 6).OrderByDescending(y => y).ToList();

    private CustomerChurnAnalysisFilter BuildFilter() => new()
    {
        Year = int.TryParse(_selectedYear, out var y) ? y : (int?)null,
        SalesEmployeeBP = string.IsNullOrWhiteSpace(_selectedSalesperson) ? null : _selectedSalesperson,
        CustomerGroup = string.IsNullOrWhiteSpace(_selectedCustomerGroup) ? null : _selectedCustomerGroup,
        IndustryName = string.IsNullOrWhiteSpace(_selectedIndustry) ? null : _selectedIndustry
        // SalesGroup: server บังคับตาม BU ของ user
    };

    private string InsightText
    {
        get
        {
            if (_data is null) return "";
            var kpi = _data.Kpi;
            var worstIndustry = _data.ChurnByIndustry.OrderByDescending(x => x.ChurnRatePercent).FirstOrDefault();

            var growthText = kpi.ExistingGrowthPercent >= 0
                ? $"existing-customer revenue grew {kpi.ExistingGrowthPercent.ToString("0.0")}%"
                : $"existing-customer revenue declined {Math.Abs(kpi.ExistingGrowthPercent).ToString("0.0")}%";

            var industryText = worstIndustry is not null
                ? $" — highest churn concentration in \"{worstIndustry.GroupName}\" ({worstIndustry.ChurnRatePercent.ToString("0.0")}%)"
                : "";

            return $"{kpi.LostCustomers} customers lost, {kpi.ChurnRatePercent.ToString("0.0")}% of the existing base, and {growthText} vs last year{industryText}. Prioritize retention for High/Critical risk accounts.";
        }
    }

    private static double GrowthBarHeight(decimal value, ChurnKpiDto kpi)
    {
        var max = Math.Max((double)kpi.ExistingRevenue, (double)kpi.PreviousExistingRevenue);
        if (max <= 0) return 0;
        return Math.Max(4, (double)value / max * 130);
    }

    private static string FormatCompact(decimal value) => Mgt.Lit.WebFront.Helpers.DashboardNumberFormatter.FormatCompact(value);

    // ⚠️ ห้ามยิง JS interop ต่อจาก StateHasChanged ในเมธอดเดียวกันทันที — ต้องรอ OnAfterRenderAsync(firstRender:false)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrWhiteSpace(AuthState.Token))
                await AuthState.InitializeAsync();

            _data = await ChurnApi.GetAsync(BuildFilter());
            _chartsNeedRender = _data is not null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_chartsNeedRender && _data is not null)
        {
            _chartsNeedRender = false;
            await RenderChartsAsync();
        }
    }

    private async Task ReloadAsync() => await LoadAsync();

    private async Task ResetAsync()
    {
        _selectedYear = DateTime.Now.Year.ToString();
        _selectedSalesperson = "";
        _selectedCustomerGroup = "";
        _selectedIndustry = "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            _data = await ChurnApi.GetAsync(BuildFilter());
            _chartsNeedRender = _data is not null;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RenderChartsAsync()
    {
        if (_data is null) return;
        var kpi = _data.Kpi;

        var basePoints = new[]
        {
            new { name = "Active Existing", value = kpi.ActiveExistingCustomers },
            new { name = "Lost (Churn)", value = kpi.LostCustomers },
            new { name = "New Sold-to Parties", value = kpi.NewCustomers }
        };
        await JS.InvokeVoidAsync("dashboardECharts.renderShareDonut", BaseDonutChartId, basePoints, "Total Sold-to Party Base");

        var trendPoints = _data.ChurnTrend
            .Select(p => new { monthName = p.MonthName, churnRatePercent = p.ChurnRatePercent })
            .ToArray();
        await JS.InvokeVoidAsync("dashboardECharts.renderChurnTrend", TrendChartId, trendPoints);

        if (_data.ChurnByIndustry.Count > 0)
        {
            var industryRows = _data.ChurnByIndustry
                .Select(r => new { groupName = r.GroupName, existingCustomers = r.ExistingCustomers, lostCustomers = r.LostCustomers, churnRatePercent = r.ChurnRatePercent })
                .ToArray();
            await JS.InvokeVoidAsync("dashboardECharts.renderChurnByGroupBar", IndustryChartId, industryRows, kpi.ChurnRatePercent);
        }
    }

    private async Task ExportToExcelAsync()
    {
        if (_data is null || _data.LostCustomers.Count == 0) return;

        try
        {
            var username = AuthState.Permission?.Username;
            var fileName = $"CustomerChurnAnalysis_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await DownloadLogSvc.LogDownloadAsync(username ?? "", fileName);

            _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/site.js");

            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("Lost Sold-to Parties");

            var headers = new[] { "Sold-to Party Code", "Sold-to Party Name", "Industry", "Salesperson", "Last Purchase", "Days", "Risk Level", "Last 12M Revenue", "Last 12M GP", "Action" };
            for (var i = 0; i < headers.Length; i++)
                ws.Cell(1, i + 1).Value = headers[i];
            var headerRow = ws.Row(1);
            headerRow.Style.Font.Bold = true;
            headerRow.Style.Fill.BackgroundColor = XLColor.LightGray;

            var row = 2;
            foreach (var r in _data.LostCustomers)
            {
                var col = 1;
                ws.Cell(row, col++).Value = r.CustomerCode;
                ws.Cell(row, col++).Value = r.CustomerName;
                ws.Cell(row, col++).Value = r.IndustryName;
                ws.Cell(row, col++).Value = r.SalesEmployeeBP;
                ws.Cell(row, col++).Value = r.LastPurchaseDate.ToString("yyyy-MM-dd");
                ws.Cell(row, col++).Value = r.DaysSinceLastPurchase;
                ws.Cell(row, col++).Value = r.RiskLevel;
                ws.Cell(row, col++).Value = r.Last12MRevenue;
                ws.Cell(row, col++).Value = r.Last12MGrossProfit;
                ws.Cell(row, col++).Value = r.Action;
                row++;
            }

            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());

            await _jsModule.InvokeVoidAsync(
                "downloadFileFromBytes",
                fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            try { await _jsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
