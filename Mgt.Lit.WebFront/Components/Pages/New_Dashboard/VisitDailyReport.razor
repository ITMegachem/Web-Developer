@page "/visit-report"
@using Mgt.Lit.WebFront.Components.Layout.MainLay
@layout AppLayout
@rendermode InteractiveServer
<link rel="stylesheet" href="/lib/bootstrap/dist/css/dash-theme.css?v=20260909a" />
@using ClosedXML.Excel
@using System.Linq
@using Microsoft.JSInterop
@using Mgt.Lit.Core.DTOs.DashBoard
@using Mgt.Lit.WebFront.Services.DashBoard
@using Mgt.Lit.WebFront.Components
@inject DashVisitDailyReportApiService VisitApi
@inject Mgt.Lit.WebFront.Auth.AuthState AuthState
@inject DownloadLogService DownloadLogSvc
@inject IJSRuntime JS
@implements IAsyncDisposable

<style>
    /* ── Visit Daily Report — สไตล์เฉพาะหน้านี้ (คำนำหน้า vdr-) ───── */
    .vdr-toolbar { display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin-bottom: 14px; }
    .vdr-btn { font-weight: 600; font-size: 14.5px; padding: 10px 20px; border-radius: 10px; white-space: nowrap; border: 1px solid var(--card-border); background: #fff; color: var(--neutral-700); }
    .vdr-btn:hover { background: var(--neutral-100); }
    .vdr-btn-export { background: #15803d; color: #fff; border-color: #15803d; }
    .vdr-btn-export:hover { opacity: .92; }
    .vdr-reset-btn { background: #fff; border: 1px solid var(--card-border); color: var(--neutral-700); font-weight: 600; font-size: 14.5px; padding: 10px 18px; border-radius: 10px; white-space: nowrap; }
    .vdr-reset-btn:hover { background: var(--neutral-100); }

    .vdr-status-badge { display: inline-block; padding: 5px 13px; border-radius: 999px; font-size: 14px; font-weight: 700; white-space: nowrap; }
    .vdr-status-badge.completed { background: #dcfce7; color: #15803d; }
    .vdr-status-badge.inprogress { background: #ffedd5; color: #c2410c; }

    .vdr-potential-badge { display: inline-block; padding: 4px 11px; border-radius: 999px; font-size: 14px; font-weight: 700; background: #dbeafe; color: #1d4ed8; white-space: nowrap; }
    .vdr-sub { display: block; font-size: 14px; color: var(--muted); margin-top: 3px; }

    /* ── ตารางรวม Visit + Product/Competitor แบบ grouped header 3 กลุ่ม ─────
       ★ .table-scroll table/td มี font-size ของตัวเองใน dash-theme.css (เปลี่ยนค่าไปตาม breakpoint ด้วย) ต้องเจาะจง
       กว่าและใส่ !important กันโดนทับ เหมือนปัญหาสีที่เจอตอนแก้ Sales Overview */
    .vdr-combined-table { border-collapse: separate; border-spacing: 0; width: 100%; }
    .table-scroll .vdr-combined-table th, .table-scroll .vdr-combined-table td {
        padding: 13px 16px; vertical-align: top; font-size: 17px !important; line-height: 1.55; border-bottom: 1px solid var(--card-border);
    }
    .table-scroll .vdr-combined-table thead th {
        position: sticky; top: 0; background: #fff; z-index: 1; color: #33443a; font-weight: 700; font-size: 16px !important;
    }
    /* ★ Customer/Contact (col 4), Product (col 6), Remark (col 12) ใช้ rowspan ข้ามหลายแถว — บังคับ font-size ตรงๆ
       กันกรณี browser render cell ที่ merge หลายแถวด้วยขนาดต่างจาก cell ปกติ */
    .table-scroll .vdr-combined-table td:nth-child(4),
    .table-scroll .vdr-combined-table td:nth-child(6),
    .table-scroll .vdr-combined-table td:nth-child(12) {
        font-size: 17px !important;
    }
    .vdr-group-visit { background: #eef6fb; }
    .vdr-group-product { background: #fdecea; }
    .vdr-group-followup { background: #eef7ee; }
    .vdr-visit-first-row td { border-top: 2px solid var(--card-border); }
    .vdr-combined-table tbody tr:hover td { background: #f7faf5; }

    /* ── Pagination ───── */
    .vdr-pager { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 14px; }
    .vdr-pager-info { font-size: 14.5px; color: var(--muted); }
    .vdr-pager-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .vdr-pager-size { display: flex; align-items: center; gap: 8px; font-size: 14.5px; color: var(--neutral-700); }
    .vdr-pager-size select { border: 1px solid var(--card-border); border-radius: 8px; padding: 6px 10px; font-size: 14.5px; background: #fff; }
    .vdr-page-btn { min-width: 38px; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--card-border); background: #fff; color: var(--neutral-700); font-weight: 600; font-size: 14.5px; }
    .vdr-page-btn:hover:not(:disabled) { background: var(--neutral-100); }
    .vdr-page-btn:disabled { opacity: .45; cursor: not-allowed; }
    .vdr-page-btn.active { background: #15803d; border-color: #15803d; color: #fff; }

    @@media print {
        .vdr-pager { display: none !important; }
        .dash-sidebar, .vdr-toolbar, .dash-filters, .app-topbar, .app-sidebar { display: none !important; }
        .table-scroll { max-height: none !important; overflow: visible !important; }
    }
</style>

<div class="dash-bg">
    <div class="dash-page">
        @if (_loading)
        {
            <div class="dash-overlay"><span class="dash-spinner"></span></div>
        }
        <div class="dash-top">
            <div>
                <div class="dash-eyebrow">Management Report</div>
                <div class="dash-title">Visit Daily Report</div>
                <div class="dash-subtitle">All visit details in one view</div>
            </div>
        </div>

        <div class="vdr-toolbar">
            @if (CanExport)
            {
                <button type="button" class="vdr-btn vdr-btn-export" @onclick="ExportToExcelAsync" disabled="@(_data is null || _data.Visits.Count == 0)">⬇ Export Excel</button>
            }
            <button type="button" class="vdr-btn" @onclick="PrintAsync">🖶 Print</button>
        </div>

        <div class="dash-filters dash-filter-panel">
            <div class="dash-field">
                <div class="dash-field-label">Visit Date Range</div>
                <input id="dateRange" class="dash-input" placeholder="Select date range" autocomplete="off" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Salesperson</div>
                <DashSelect @bind-Value="_selectedSalesperson" @bind-Value:after="ReloadAsync"
                            Placeholder="All" Options="@(_data?.AvailableSalesEmployees ?? new())" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Sold-to Party</div>
                <DashSelect @bind-Value="_selectedCustomer" @bind-Value:after="ReloadAsync"
                            Placeholder="All" Options="@(_data?.AvailableCustomers ?? new())" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Deal Status</div>
                <DashSelect @bind-Value="_selectedDealStatus" @bind-Value:after="ResetPage" Placeholder="All" Options="@(new List<string> { "Won", "Open", "Lost", "No Deal" })" />
            </div>
            <div class="dash-field">
                <div class="dash-field-label">Search</div>
                <input class="dash-input" placeholder="Search visit no., customer, deal name, material..." @bind="_searchText" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <div class="dash-field" style="align-self:flex-end">
                <button type="button" class="vdr-reset-btn" @onclick="ResetAsync">↺ Reset</button>
            </div>
        </div>

        @if (_data is null)
        {
            <div class="dash-loading" role="status">
                <span class="dash-spinner" aria-hidden="true"></span>
                <span>Loading visit report data</span>
            </div>
        }
        else
        {
            var allVisits = FilteredVisits;
            var totalPages = Math.Max(1, (int)Math.Ceiling(allVisits.Count / (double)_pageSize));
            if (_page > totalPages) _page = totalPages;
            var pagedVisits = allVisits.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

            <div class="dash-card">
                <div class="dash-card-header">Visit Details</div>
                <div class="dash-card-body">
                    <div class="table-scroll" style="max-height:700px;">
                        <table class="table table-striped table-hover vdr-combined-table">
                            <thead>
                                <tr>
                                    <th class="vdr-group-visit" colspan="5">Visit details</th>
                                    <th class="vdr-group-product" colspan="6">Materials &amp; competitors</th>
                                    <th class="vdr-group-followup" colspan="1">Follow-up</th>
                                </tr>
                                <tr>
                                    <th>Visit No.</th>
                                    <th>Date</th>
                                    <th>Salesperson</th>
                                    <th>Sold-to Party / Contact</th>
                                    <th>Status</th>
                                    <th>Material</th>
                                    <th>Price</th>
                                    <th>Consumption</th>
                                    <th>Competitor</th>
                                    <th>Notes</th>
                                    <th>Potential</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (allVisits.Count == 0)
                                {
                                    <tr><td colspan="12" class="dash-table-empty">No visit reports for this filter</td></tr>
                                }
                                else
                                {
                                    @foreach (var visit in pagedVisits)
                                    {
                                        var rowCount = Math.Max(1, visit.Items.Count);
                                        @for (var i = 0; i < rowCount; i++)
                                        {
                                            var item = i < visit.Items.Count ? visit.Items[i] : null;
                                            <tr class="@(i == 0 ? "vdr-visit-first-row" : "")">
                                                @if (i == 0)
                                                {
                                                    <td rowspan="@rowCount">@visit.VisitNumber</td>
                                                    <td rowspan="@rowCount">@(visit.VisitDate?.ToString("yyyy-MM-dd") ?? "")</td>
                                                    <td rowspan="@rowCount">@visit.SalesEmployeeBP</td>
                                                    <td rowspan="@rowCount">
                                                        @visit.CustomerName
                                                        @if (!string.IsNullOrWhiteSpace(visit.ContactPersons))
                                                        {
                                                            <span class="vdr-sub">@visit.ContactPersons</span>
                                                        }
                                                    </td>
                                                    <td rowspan="@rowCount">@RenderStatusBadge(visit.Status)</td>
                                                }
                                                @if (item is not null)
                                                {
                                                    <td>@(item.MaterialName ?? "—")</td>
                                                    <td>@(item.Price ?? "—")</td>
                                                    <td>@(item.Consumption ?? "—")</td>
                                                    <td>@CompetitorCell(item)</td>
                                                    <td>@(string.IsNullOrWhiteSpace(item.StatusNote) ? "—" : item.StatusNote)</td>
                                                    <td>@RenderPotentialBadge(item.Potential)</td>
                                                }
                                                else
                                                {
                                                    <td colspan="6" class="dash-table-empty">No products discussed</td>
                                                }
                                                @if (i == 0)
                                                {
                                                    <td rowspan="@rowCount">@(string.IsNullOrWhiteSpace(visit.DescriptionRemark) ? "—" : visit.DescriptionRemark)</td>
                                                }
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="vdr-pager">
                        <div class="vdr-pager-info">
                            @if (allVisits.Count == 0)
                            {
                                <span>No visits</span>
                            }
                            else
                            {
                                <span>Showing @((_page - 1) * _pageSize + 1)–@(Math.Min(_page * _pageSize, allVisits.Count)) of @allVisits.Count visits</span>
                            }
                        </div>
                        <div class="vdr-pager-controls">
                            <label class="vdr-pager-size">
                                Rows per page
                                <select @bind="_pageSize" @bind:after="ResetPage">
                                    @foreach (var size in PageSizeOptions)
                                    {
                                        <option value="@size">@size</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="vdr-page-btn" disabled="@(_page <= 1)" @onclick="() => GoToPage(1)">«</button>
                            <button type="button" class="vdr-page-btn" disabled="@(_page <= 1)" @onclick="() => GoToPage(_page - 1)">‹</button>
                            @foreach (var p in VisiblePages(_page, totalPages))
                            {
                                var target = p;
                                <button type="button" class="vdr-page-btn @(target == _page ? "active" : "")" @onclick="() => GoToPage(target)">@target</button>
                            }
                            <button type="button" class="vdr-page-btn" disabled="@(_page >= totalPages)" @onclick="() => GoToPage(_page + 1)">›</button>
                            <button type="button" class="vdr-page-btn" disabled="@(_page >= totalPages)" @onclick="() => GoToPage(totalPages)">»</button>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>

@code {
    private VisitDailyReportDto? _data;
    private bool _loading;

    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private string _selectedSalesperson = "";
    private string _selectedCustomer = "";
    private string _selectedDealStatus = "";   // client-side quick filter — ไม่ยิง API ใหม่
    private string _searchText = "";        // client-side quick filter — ไม่ยิง API ใหม่

    private static readonly int[] PageSizeOptions = { 10, 50, 100 };
    private int _pageSize = 10;
    private int _page = 1;

    private void ResetPage() => _page = 1;
    private void GoToPage(int page) => _page = Math.Max(1, page);

    // หน้าที่แสดงเป็นปุ่ม: หน้าปัจจุบัน ±2 (เลื่อนตามหน้า) ไม่แสดงครบทุกหน้า เพราะ 100 ต่อหน้าอาจเหลือแค่ไม่กี่หน้า แต่ 10 ต่อหน้าอาจมีเป็นสิบๆ หน้า
    private static IEnumerable<int> VisiblePages(int current, int total)
    {
        var start = Math.Max(1, current - 2);
        var end = Math.Min(total, start + 4);
        start = Math.Max(1, end - 4);
        return Enumerable.Range(start, end - start + 1);
    }

    private bool CanExport => Mgt.Lit.WebFront.Auth.ReportAccessHelper.CanExportReport(AuthState.User, "VisitDailyReport");

    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<VisitDailyReport>? _dotNetRef;

    private VisitDailyReportFilter BuildFilter() => new()
    {
        DateFrom = _dateFrom,
        DateTo = _dateTo,
        SalesEmployeeBP = string.IsNullOrWhiteSpace(_selectedSalesperson) ? null : _selectedSalesperson,
        CustomerName = string.IsNullOrWhiteSpace(_selectedCustomer) ? null : _selectedCustomer
        // SalesGroup: server บังคับตาม BU ของ user
    };

    // ★ Status/Search กรองในหน่วยความจำเท่านั้น (ไม่กระทบ KPI ที่มาจาก server เสมอ) — ให้ตอบสนองทันทีไม่ต้องรอ round trip
    private List<VisitRowDto> FilteredVisits =>
        (_data?.Visits ?? new())
            .Where(v => string.IsNullOrWhiteSpace(_selectedDealStatus) || v.DealStatus == _selectedDealStatus)
            .Where(v => string.IsNullOrWhiteSpace(_searchText) || MatchesSearch(v, _searchText.Trim()))
            .ToList();

    private static bool MatchesSearch(VisitRowDto v, string search) =>
        v.VisitNumber.Contains(search, StringComparison.OrdinalIgnoreCase)
        || v.CustomerName.Contains(search, StringComparison.OrdinalIgnoreCase)
        || v.SalesEmployeeBP.Contains(search, StringComparison.OrdinalIgnoreCase)
        || v.DescriptionRemark.Contains(search, StringComparison.OrdinalIgnoreCase)
        || v.RelatedDealNames.Contains(search, StringComparison.OrdinalIgnoreCase)
        || v.Items.Any(i => (i.MaterialName ?? "").Contains(search, StringComparison.OrdinalIgnoreCase));

    private RenderFragment CompetitorCell(VisitItemDetailDto item) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(item.CompetitorName) && string.IsNullOrWhiteSpace(item.CompetitorSupplier))
        {
            @:—
        }
        else
        {
            @(item.CompetitorName ?? item.CompetitorSupplier)
            @if (!string.IsNullOrWhiteSpace(item.CompetitorName) && !string.IsNullOrWhiteSpace(item.CompetitorSupplier) && item.CompetitorName != item.CompetitorSupplier)
            {
                <span class="vdr-sub">@item.CompetitorSupplier</span>
            }
        }
    };

    private RenderFragment RenderStatusBadge(string status) => __builder =>
    {
        var cssClass = status == "Completed" ? "completed" : "inprogress";
        <span class="vdr-status-badge @cssClass">@status</span>
    };

    private RenderFragment RenderPotentialBadge(string? potential) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(potential) || potential.Trim().Equals("no", StringComparison.OrdinalIgnoreCase) || potential.Trim() == "-")
        {
            @:—
        }
        else
        {
            <span class="vdr-potential-badge">@potential</span>
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrWhiteSpace(AuthState.Token))
                await AuthState.InitializeAsync();

            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/site.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _jsModule.InvokeVoidAsync("initDateRange", _dotNetRef);

            _dateFrom = DateTime.Now.Date.AddMonths(-2);
            _dateTo = DateTime.Now.Date;

            _data = await VisitApi.GetAsync(BuildFilter());
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task SetDateRange(string start, string end)
    {
        if (string.IsNullOrEmpty(start) || string.IsNullOrEmpty(end))
        {
            _dateFrom = null; _dateTo = null;
        }
        else
        {
            if (DateTime.TryParse(start, out var s)) _dateFrom = s;
            if (DateTime.TryParse(end, out var e)) _dateTo = e;
        }
        await LoadAsync();
    }

    private async Task ReloadAsync() => await LoadAsync();

    private async Task ResetAsync()
    {
        _selectedSalesperson = "";
        _selectedCustomer = "";
        _selectedDealStatus = "";
        _searchText = "";
        _dateFrom = DateTime.Now.Date.AddMonths(-2);
        _dateTo = DateTime.Now.Date;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _page = 1; StateHasChanged();
        try
        {
            _data = await VisitApi.GetAsync(BuildFilter());
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("eval", "window.print()");

    private async Task ExportToExcelAsync()
    {
        if (_data is null || _data.Visits.Count == 0) return;

        try
        {
            var username = AuthState.Permission?.Username;
            var fileName = $"VisitDailyReport_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await DownloadLogSvc.LogDownloadAsync(username ?? "", fileName);

            _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/site.js");

            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("Visit Daily Report");

            var headers = new[]
            {
                "Visit No.", "Date", "Salesperson", "Sold-to Party", "Contact Person(s)", "Start", "End", "Duration (min)", "Status",
                "Material", "Price", "Consumption", "Competitor", "Competitor Supplier", "Potential", "Notes", "Remark"
            };
            for (var i = 0; i < headers.Length; i++)
                ws.Cell(1, i + 1).Value = headers[i];

            var headerRow = ws.Row(1);
            headerRow.Style.Font.Bold = true;
            headerRow.Style.Fill.BackgroundColor = XLColor.LightGray;

            var row = 2;
            foreach (var visit in FilteredVisits)
            {
                var items = visit.Items.Count == 0 ? new List<VisitItemDetailDto> { new() } : visit.Items;
                foreach (var item in items)
                {
                    var col = 1;
                    ws.Cell(row, col++).Value = visit.VisitNumber;
                    ws.Cell(row, col++).Value = visit.VisitDate?.ToString("yyyy-MM-dd") ?? "";
                    ws.Cell(row, col++).Value = visit.SalesEmployeeBP;
                    ws.Cell(row, col++).Value = visit.CustomerName;
                    ws.Cell(row, col++).Value = visit.ContactPersons;
                    ws.Cell(row, col++).Value = visit.StartDateTime?.ToString("HH:mm") ?? "";
                    ws.Cell(row, col++).Value = visit.EndDateTime?.ToString("HH:mm") ?? "";
                    if (visit.DurationMinutes.HasValue) ws.Cell(row, col).Value = visit.DurationMinutes.Value;
                    col++;
                    ws.Cell(row, col++).Value = visit.Status;
                    ws.Cell(row, col++).Value = item.MaterialName ?? "";
                    ws.Cell(row, col++).Value = item.Price ?? "";
                    ws.Cell(row, col++).Value = item.Consumption ?? "";
                    ws.Cell(row, col++).Value = item.CompetitorName ?? "";
                    ws.Cell(row, col++).Value = item.CompetitorSupplier ?? "";
                    ws.Cell(row, col++).Value = item.Potential ?? "";
                    ws.Cell(row, col++).Value = item.StatusNote ?? "";
                    ws.Cell(row, col++).Value = visit.DescriptionRemark ?? "";
                    row++;
                }
            }

            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());

            await _jsModule.InvokeVoidAsync(
                "downloadFileFromBytes",
                fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            try { await _jsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _dotNetRef?.Dispose();
    }
}
