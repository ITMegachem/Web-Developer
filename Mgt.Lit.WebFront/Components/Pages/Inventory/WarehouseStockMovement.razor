@namespace Mgt.Lit.WebFront.Pages
@page "/warehouse-stock-movement"
@* --- 1. แก้ Error: เพิ่ม Path ของ Layout (ปรับตามโฟลเดอร์จริงของคุณ) --- *@
@using ClosedXML.Excel
@using Mgt.Lit.WebFront.Components.Layout.MainLay
@using Mgt.Lit.WebFront.Models.SalesOrder
@using Mgt.Lit.WebFront.Services
@using Mgt.Lit.WebFront.Services.Member
@using Mgt.Lit.WebFront.Services.SalesOrder
@using OfficeOpenXml
@inject StockService StockService
@layout AppLayout
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject PageContext PageContext
@inject IJSRuntime JS
@inject DownloadLogService DownloadLogSvc
@inject Mgt.Lit.WebFront.Auth.AuthState AuthState
 
<div class="so-page-wrapper">
    @* --- Header Section (ชื่อหน้าและวันที่ขวาสุด) --- *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <h2 class="page-title">MD04 - 02 Monitor Stock / Requirements List</h2>
        <div class="date-badge">@DateTime.Now.ToString("dd MMM yyyy")</div>
    </div>

    @* --- ส่วน Filter (UI เขียวพาสเทล ขอบมน) --- *@
    <div class="filter-card-modern shadow-sm mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="modern-label">Material</label>

                <div class="autocomplete-wrapper">

                    <div class="form-control modern-input"
                         style="background:#fff0f0; border: 2px solid #dc3545; color:#dc3545; min-height:38px;">
                        @if (!string.IsNullOrWhiteSpace(selectedMaterialName))
                        {
                            @selectedMaterialName
                        }
                        @* ✅ fallback จาก stockData ถ้า selectedMaterialName ว่าง *@
                        else if (!string.IsNullOrWhiteSpace(stockData?.Detail?.FirstOrDefault()?.MaterialDescription))
                        {
                            @stockData.Detail.First().MaterialDescription
                        }
                        else
                        {
                            <span class="text-muted">description material</span>
                        }
                    </div>
            </div>
            <div class="col-12 col-md-4">
                <label class="modern-label">Material Description</label>
                <div class="form-control modern-input"
                     style="background:#fff0f0; border: 2px solid #dc3545; color:#dc3545; min-height:38px;">
                    @if (!string.IsNullOrWhiteSpace(selectedMaterialName))
                    {
                        @selectedMaterialName
                    }
                    else
                    {
                        <span class="text-muted">description material</span>
                    }
                </div>
            </div>
            @* --- ปุ่ม Toggle Vendor / Customer --- *@
            @* ✅ แสดงปุ่มถ้า CanView นั้นๆ เป็น true ไม่จำกัดเฉพาะ Manager *@
            <div class="col-12 col-md-auto d-flex align-items-end gap-2 mt-2 mt-md-0">
                @if (CanViewVendor)
                {
                    <button class="btn btn-sm @(showVendor ? "btn-success" : "btn-outline-secondary") rounded-pill px-3"
                            @onclick="() => showVendor = !showVendor">
                        <i class="bi @(showVendor ? "bi-eye-fill" : "bi-eye-slash-fill") me-1"></i>
                        @("Vendor")
                    </button>
                }
                @if (CanViewCustomer)
                {
                    <button class="btn btn-sm @(showCustomer ? "btn-success" : "btn-outline-secondary") rounded-pill px-3"
                            @onclick="() => showCustomer = !showCustomer">
                        <i class="bi @(showCustomer ? "bi-eye-fill" : "bi-eye-slash-fill") me-1"></i>
                        @("Customer")
                    </button>
                }
            </div>
            <div class="col-12 col-md-4 col-lg-2 ms-auto">
                <button class="btn btn-search-pill w-100"
                        disabled="@string.IsNullOrWhiteSpace(materialSearch)"
                        @onclick="OnSearch">

                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <span><i class="bi bi-search me-1"></i> Run</span>
                    }
                </button>
            </div>
            
        </div>
    </div>

    @* --- ส่วนตารางข้อมูล (สไตล์เดียวกับ Sales Orders) --- *@
    <div class="table-card-container shadow-sm">
        <div class="table-responsive flex-grow-1">
            <table class="table modern-table mb-0 fixed-table">
                <thead class="table-light">
                    @{
                        var colCount = 8 + (ShowVendorCol ? 1 : 0) + (ShowCustomerCol ? 1 : 0);
                    }

                    <tr class="table-header-modern">
                        <th class="text-center">Date</th>
                        <th class="text-center">MRP<br />Element Type</th>
                        <th class="text-center">MRP<br />Element Data</th>
                        <th class="text-center">Receipt /<br />Reqmt</th>
                        <th class="text-center">Available<br />Qty</th>
                        <th class="text-center">Additional<br />Info IN</th>
                        @if (ShowVendorCol)
                        {
                            <th class="text-center">Vendor Code /<br />Vendor Name</th>
                        }
                        <th class="text-center">Additional<br />Info Out</th>
                        @if (ShowCustomerCol)
                        {
                            <th class="text-center">Customer Code /<br />Customer Name</th>
                        }
                        <th class="text-center">Material<br />Group</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!hasSearched)
                    {
                        <tr>
                            <td colspan="@colCount" class="text-center text-muted py-4">
                                <p style="font-size: 100% !important;">กรุณากรอกข้อมูลและค้นหา</p>
                            </td>
                        </tr>
                    }
                    else if (stockData?.Detail != null && stockData.Detail.Any())
                    {
                        @foreach (var item in stockData.Detail)
                        {
                            <tr>
                                <td class="text-center align-middle text-nowrap">
                                    @item.DocumentDate.ToString("dd-MM-yyyy")
                                </td>
                                <td class="text-center align-middle">@item.ElementType</td>
                                <td class="text-center align-middle">@item.DocumentNo</td>
                                <td class="text-center align-middle">@item.ReceiptReqmtQty.ToString("N0")</td>
                                <td class="text-center align-middle">@item.AvailableQty.ToString("N0")</td>
                                <td class="text-center align-middle">
                                    @if (!string.IsNullOrWhiteSpace(item.AdditionalInfoIn))
                                    {
                                        var lines = item.AdditionalInfoIn.Split('\n');
        
                                        @* ✅ ETA ก่อน ETD *@
                                        var eta = lines.FirstOrDefault(l => l.Trim().StartsWith("ETA"));
                                        var etd = lines.FirstOrDefault(l => l.Trim().StartsWith("ETD"));
                                        var others = lines.Where(l =>
                                            !l.Trim().StartsWith("ETA") &&
                                            !l.Trim().StartsWith("ETD") &&
                                            !string.IsNullOrWhiteSpace(l));

                                        @if (!string.IsNullOrWhiteSpace(eta))
                                        {
                                            <div>@eta.Trim()</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(etd))
                                        {
                                            <div>@etd.Trim()</div>
                                        }
                                        @foreach (var line in others)
                                        {
                                            <div>@line.Trim()</div>
                                        }
                                    }
                                </td>
                                @if (ShowVendorCol)
                                {
                                    <td class="align-middle">
                                        <div class="fw-bold">@item.VendorCode</div>
                                        <div class="text-muted small">@item.VendorName</div>
                                    </td>
                                }
                                <td class="text-center align-middle">
                                    @if (!string.IsNullOrWhiteSpace(item.IndustryName))
                                    {
                                        <div><b>@item.IndustryName</b></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.AdditionalInfoOut))
                                    {
                                        <div>@item.AdditionalInfoOut</div>
                                    }
                                </td>
                                @if (ShowCustomerCol)
                                {
                                    <td class="align-middle">
                                        <div class="fw-bold">@item.CustomerCode</div>
                                        <div class="text-muted small">@item.CustomerName</div>
                                    </td>
                                }
                                <td class="align-middle text-center">
                                    <div class="text-muted small">@item.MaterialGroupDescription</div>
                                </td>
                            </tr>
                        }
                    }
                    else if (!isLoading)
                    {
                        <tr>
                            <td colspan="@colCount" class="text-center text-muted py-4">
                                ไม่พบข้อมูล
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

        @* --- Pagination (ลูกศรหนาแบบในรูป) --- *@
        @if (hasSearched && stockData?.Detail != null && stockData.Detail.Any())
        {
            <div class="table-footer-pagination">
                <div class="text-muted small">
                    Results: @stockData.Detail.Count items
                </div>

                <div class="pagination-controls d-flex align-items-center gap-3">
                    <button class="pill-nav-btn">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div class="page-indicator">
                        <span class="fw-bold text-success">1</span> / 1
                    </div>

                    <button class="pill-nav-btn">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }


    @* --- ปุ่ม Export --- *@
    <div class="d-flex justify-content-end mt-4 gap-3">

        @if (CanExportConsumption)
        {
            <button class="btn btn-export-pill shadow-sm"
                    disabled="@string.IsNullOrWhiteSpace(selectedMaterial)"
                    @onclick="ExportConsumption">
                <i class="bi bi-graph-down me-2"></i> Export Consumption
            </button>
        }

        
    </div>
</div>
@code {
    private IJSObjectReference? _jsModule;
    private StockRequirementResponse stockData;
    private string selectedPlant;
    private string selectedMaterial;
    private bool isLoading = false;
    private string errorMessage;
    private bool hasSearched = false;
    private string materialSearch = "";
    private bool showMaterialDropdown = false;
    private List<MaterialLookup> materialResults = new();
    private CancellationTokenSource? _materialCts;
    private bool CanViewVendor => AuthState.Permission?.CanViewVendor ?? false;
    private bool CanViewCustomer => AuthState.Permission?.CanViewCustomer ?? false;
    private MaterialLookup? _lastSelectedMaterial;
    private string selectedMaterialName = "";
    private bool showVendor = true;
    private bool showCustomer = true;

    private bool ShowVendorCol => CanViewVendor && showVendor;
    private bool ShowCustomerCol => CanViewCustomer && showCustomer;
    // ✅ Consumption — Purchase ทุกระดับได้, Sales block เฉพาะ user
    private bool CanExportConsumption
    {
        get
        {
            var p = AuthState.Permission;
            if (p == null) return false;

            // 🔒 Block user
            if (new[] { 39, 55, 56, 57 }.Contains(p.UserID))
                return false;

            if (!p.CanViewCost) return false;

            var role = p.UserRole?.ToLower();
            var dept = p.Department?.ToLower();

            if (dept == "sales" && role == "user")
                return false;
            Console.WriteLine($"UserID: {AuthState.Permission?.UserID}");
            Console.WriteLine($"Type: {AuthState.Permission?.UserID.GetType()}");
            return true;
        }
    }

    // ✅ Excel — block Sales user และ Purchase user
    private bool CanExportExcel
    {
        get
        {
            if (AuthState.Permission == null) return false;
            var role = AuthState.Permission.UserRole?.ToLower() ?? "";
            var dept = AuthState.Permission.Department?.ToLower() ?? "";
            if (role == "user") return false; // block ทุก user
            return true;
        }
    }
    private async Task OnMaterialSearch(ChangeEventArgs e)
    {
        materialSearch = e.Value?.ToString() ?? "";
        selectedMaterial = null;
        selectedMaterialName = "";
        _lastSelectedMaterial = null;  // ✅ reset cache
        materialResults.Clear();
        showMaterialDropdown = false;
        stockData = null;
        hasSearched = false;

        if (string.IsNullOrWhiteSpace(materialSearch) || materialSearch.Length < 2)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        _materialCts?.Cancel();
        _materialCts = new CancellationTokenSource();
        var token = _materialCts.Token;

        try
        {
            await Task.Delay(150, token);
            if (token.IsCancellationRequested) return;

            materialResults = await StockService.SearchMaterialForStockMovement(materialSearch)
                ?? new();

            // ✅ exact match → auto-select ปิด dropdown ทันที
            var exact = materialResults.FirstOrDefault(x =>
                x.Code.Equals(materialSearch.Trim(), StringComparison.OrdinalIgnoreCase));

            if (exact != null)
            {
                SelectMaterial(exact);
            }
            else
            {
                showMaterialDropdown = materialResults.Any();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _materialCts?.Cancel();
        _materialCts?.Dispose();

        try
        {
            if (_jsModule is not null)
                await _jsModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
    private void OnMaterialFocus()
    {
        // ✅ ไม่เปิดถ้า input ตรงกับ selectedMaterial แล้ว (แสดงว่าเลือกแล้ว)
        if (!string.IsNullOrWhiteSpace(selectedMaterial) &&
            materialSearch.StartsWith(selectedMaterial, StringComparison.OrdinalIgnoreCase))
            return;

        if (materialResults.Any())
            showMaterialDropdown = true;
    }

    private async Task OnMaterialBlur()
    {
        await Task.Delay(200);
        showMaterialDropdown = false;
        // ✅ ไม่ clear materialResults เพื่อให้ OnSearch ใช้ match ได้
        await InvokeAsync(StateHasChanged);
    }
    private void SelectMaterial(MaterialLookup item)
    {
        _lastSelectedMaterial = item;  // ✅ cache
        selectedMaterial = item.Code;
        materialSearch = item.Code;
        selectedMaterialName = item.Name ?? "";
        materialResults.Clear();
        showMaterialDropdown = false;
    }
    protected override Task OnInitializedAsync()
    {
        PageContext.Menu = "Sales";
        PageContext.Page = "Stock Movement";
        selectedPlant = "";
        selectedMaterial = "";

        return Task.CompletedTask;

       
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/site.js");
            Console.WriteLine($"Permission null? {AuthState.Permission == null}");
            Console.WriteLine($"UserRole: '{AuthState.Permission?.UserRole}'");
            Console.WriteLine($"Department: '{AuthState.Permission?.Department}'");
        }
    }
    private async Task LoadData()
    {
        Console.WriteLine("LoadData Called");

        try
        {
            isLoading = true;

            stockData = await StockService
                .GetStockRequirement(selectedPlant, selectedMaterial);

            Console.WriteLine("stockData null? " + (stockData == null));
            Console.WriteLine("Detail count: " + stockData?.Detail?.Count);
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERROR: " + ex.Message);
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private List<PlantDto> plants = new()
{
    new() { PlantCode = "1100", PlantName = "Megachem (Thailand) PCL" },
    //new() { PlantCode = "1900", PlantName = "MGT Riteoff Plant" },
    new() { PlantCode = "2100", PlantName = "Green Leaf Chemical" }
};
    private async Task OnSearch()
    {
        hasSearched = true;
        showMaterialDropdown = false;

        var input = materialSearch?.Trim();
        if (string.IsNullOrWhiteSpace(input)) return;

        if (!string.IsNullOrWhiteSpace(selectedMaterial))
        {
            // ✅ เลือกจาก dropdown แล้ว → ใช้ได้เลย
        }
        else if (_lastSelectedMaterial != null)
        {
            // ✅ cache ยังอยู่ → restore
            SelectMaterial(_lastSelectedMaterial);
        }
        else
        {
            // ✅ พิมพ์ค้าง → exact match จาก results ก่อน
            var matched = materialResults.FirstOrDefault(x =>
                x.Code.Equals(input, StringComparison.OrdinalIgnoreCase));

            if (matched != null)
            {
                SelectMaterial(matched);
            }
            else
            {
                // ✅ ใช้ค่าที่พิมพ์ตรงๆ ไม่บังคับเลือก
                selectedMaterial = input.Contains(' ') ? input[..input.IndexOf(' ')] : input;
                materialSearch = selectedMaterial;
            }
        }

        materialResults.Clear();

        await InvokeAsync(StateHasChanged); // ✅ ปิด dropdown ก่อน load
        await LoadData();
    }
    private async Task ExportData()
    {
        if (!CanExportExcel) return;
        if (stockData?.Detail == null || !stockData.Detail.Any()) return;
        var exportPassword = AuthState.ExportPassword;
        if (string.IsNullOrWhiteSpace(exportPassword))
        {
            exportPassword = await JS.InvokeAsync<string>(
                "sessionStorage.getItem", "ep");
        }
        var username = AuthState.Permission?.Username;
        var fileName = $"StockMovement_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        await DownloadLogSvc.LogDownloadAsync(username, fileName);

        ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
        using var package = new ExcelPackage();
        var ws = package.Workbook.Worksheets.Add("StockMovement");

        string[] headers = {
        "Date", "MRP Element Type", "MRP Element Data",
        "Receipt/Reqmt", "Available Qty", "Additional Info In",
        "Vendor Code", "Vendor Name", "Additional Info Out",
        "Customer Code", "Customer Name", "Material Group",
        "Material Group Description"
    };

        for (int i = 0; i < headers.Length; i++)
        {
            ws.Cells[1, i + 1].Value = headers[i];
            ws.Cells[1, i + 1].Style.Font.Bold = true;
            ws.Cells[1, i + 1].Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
            ws.Cells[1, i + 1].Style.Fill.BackgroundColor
                .SetColor(System.Drawing.Color.LightGray);
        }

        int row = 2;
        foreach (var item in stockData.Detail)
        {
            ws.Cells[row, 1].Value = item.DocumentDate.ToString("dd/MM/yyyy");
            ws.Cells[row, 2].Value = item.ElementType;
            ws.Cells[row, 3].Value = item.RefDoc;
            ws.Cells[row, 4].Value = item.ReceiptReqmtQty;
            ws.Cells[row, 5].Value = item.AvailableQty;
            ws.Cells[row, 6].Value = item.AdditionalInfoIn;
            ws.Cells[row, 7].Value = item.VendorCode;
            ws.Cells[row, 8].Value = item.VendorName;
            ws.Cells[row, 9].Value = item.AdditionalInfoOut ?? "";
            ws.Cells[row, 10].Value = item.CustomerCode;
            ws.Cells[row, 11].Value = item.CustomerName;
            ws.Cells[row, 12].Value = item.MaterialGroup;
            ws.Cells[row, 13].Value = item.MaterialGroupDescription;
            row++;
        }

        ws.Cells[ws.Dimension.Address].AutoFitColumns();

       
        // ✅ file-level password ที่แท้จริง
        using var ms = new MemoryStream();
        if (!string.IsNullOrWhiteSpace(exportPassword))
            package.SaveAs(ms, exportPassword); // 🔐
        else
            package.SaveAs(ms);

        var base64 = Convert.ToBase64String(ms.ToArray());

        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync(
                "downloadFileFromBytes", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
    }
    private async Task ExportConsumption()
    {
        if (!CanExportConsumption) return;

        if (string.IsNullOrWhiteSpace(selectedMaterial))
            return;

        var data = await StockService.GetMaterialConsumption(selectedMaterial);

        if (data == null || !data.Any())
            return;

        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("Consumption");

        // ── Header ────────────────────────────────────────────────────────────
        string[] headers =
{
    "Year",
    "January", "January (KG)",
    "February", "February (KG)",
    "March", "March (KG)",
    "April", "April (KG)",
    "May", "May (KG)",
    "June", "June (KG)",
    "July", "July (KG)",
    "August", "August (KG)",
    "September", "September (KG)",
    "October", "October (KG)",
    "November", "November (KG)",
    "December", "December (KG)",
    "Total", "Total (KG)"
};

        for (int i = 0; i < headers.Length; i++)
            ws.Cell(1, i + 1).Value = headers[i];

        ws.Row(1).Style.Font.Bold = true;
        ws.Row(1).Style.Fill.BackgroundColor = XLColor.LightGreen;

        // ── Data Rows ─────────────────────────────────────────────────────────
        int row = 2;
        foreach (var item in data)
        {
            ws.Cell(row, 1).Value = item.Year;
            ws.Cell(row, 2).Value = item.January;
            ws.Cell(row, 3).Value = item.JanuaryKG;
            ws.Cell(row, 4).Value = item.February;
            ws.Cell(row, 5).Value = item.FebruaryKG;
            ws.Cell(row, 6).Value = item.March;
            ws.Cell(row, 7).Value = item.MarchKG;
            ws.Cell(row, 8).Value = item.April;
            ws.Cell(row, 9).Value = item.AprilKG;
            ws.Cell(row, 10).Value = item.May;
            ws.Cell(row, 11).Value = item.MayKG;
            ws.Cell(row, 12).Value = item.June;
            ws.Cell(row, 13).Value = item.JuneKG;
            ws.Cell(row, 14).Value = item.July;
            ws.Cell(row, 15).Value = item.JulyKG;
            ws.Cell(row, 16).Value = item.August;
            ws.Cell(row, 17).Value = item.AugustKG;
            ws.Cell(row, 18).Value = item.September;
            ws.Cell(row, 19).Value = item.SeptemberKG;
            ws.Cell(row, 20).Value = item.October;
            ws.Cell(row, 21).Value = item.OctoberKG;
            ws.Cell(row, 22).Value = item.November;
            ws.Cell(row, 23).Value = item.NovemberKG;
            ws.Cell(row, 24).Value = item.December;
            ws.Cell(row, 25).Value = item.DecemberKG;
            ws.Cell(row, 26).Value = item.Total;
            ws.Cell(row, 27).Value = item.TotalKG;
            row++;
        }

        // ── Total Row ─────────────────────────────────────────────────────────
        ws.Cell(row, 1).Value = "Total";
        ws.Cell(row, 2).Value = data.Sum(x => x.January);
        ws.Cell(row, 3).Value = data.Sum(x => x.JanuaryKG ?? 0);
        ws.Cell(row, 4).Value = data.Sum(x => x.February);
        ws.Cell(row, 5).Value = data.Sum(x => x.FebruaryKG ?? 0);
        ws.Cell(row, 6).Value = data.Sum(x => x.March);
        ws.Cell(row, 7).Value = data.Sum(x => x.MarchKG ?? 0);
        ws.Cell(row, 8).Value = data.Sum(x => x.April);
        ws.Cell(row, 9).Value = data.Sum(x => x.AprilKG ?? 0);
        ws.Cell(row, 10).Value = data.Sum(x => x.May);
        ws.Cell(row, 11).Value = data.Sum(x => x.MayKG ?? 0);
        ws.Cell(row, 12).Value = data.Sum(x => x.June);
        ws.Cell(row, 13).Value = data.Sum(x => x.JuneKG ?? 0);
        ws.Cell(row, 14).Value = data.Sum(x => x.July);
        ws.Cell(row, 15).Value = data.Sum(x => x.JulyKG ?? 0);
        ws.Cell(row, 16).Value = data.Sum(x => x.August);
        ws.Cell(row, 17).Value = data.Sum(x => x.AugustKG ?? 0);
        ws.Cell(row, 18).Value = data.Sum(x => x.September);
        ws.Cell(row, 19).Value = data.Sum(x => x.SeptemberKG ?? 0);
        ws.Cell(row, 20).Value = data.Sum(x => x.October);
        ws.Cell(row, 21).Value = data.Sum(x => x.OctoberKG ?? 0);
        ws.Cell(row, 22).Value = data.Sum(x => x.November);
        ws.Cell(row, 23).Value = data.Sum(x => x.NovemberKG ?? 0);
        ws.Cell(row, 24).Value = data.Sum(x => x.December);
        ws.Cell(row, 25).Value = data.Sum(x => x.DecemberKG ?? 0);
        ws.Cell(row, 26).Value = data.Sum(x => x.Total);
        ws.Cell(row, 27).Value = data.Sum(x => x.TotalKG ?? 0);

        var totalRow = ws.Row(row);
        totalRow.Style.Font.Bold = true;
        totalRow.Style.Fill.BackgroundColor = XLColor.LightGray;
        totalRow.Style.Border.TopBorder = XLBorderStyleValues.Medium;

        ws.Columns().AdjustToContents();

        // ── Download ──────────────────────────────────────────────────────────
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());

        await _jsModule.InvokeVoidAsync(
            "downloadFileFromBytes",
            $"MaterialConsumption_{selectedMaterial}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            base64);
    }
    private bool IsManagerOrAbove
    {
        get
        {
            if (AuthState.Permission == null) return false;
            var role = AuthState.Permission.UserRole?.ToLower() ?? "";
            return role == "manager" || role == "admin";
        }
    }
}