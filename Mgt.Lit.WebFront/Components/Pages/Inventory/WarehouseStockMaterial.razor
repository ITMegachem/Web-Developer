    public async ValueTask DisposeAsync()
    {
        if (_isDisposed)
            return;

        _isDisposed = true;
        _materialCts?.Cancel();
        _materialCts?.Dispose();
        var module = _jsModule;
        _jsModule = null;

        try
        {
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }

    }
    private static readonly Dictionary<string, string> DisplayPlantToCompany = new(StringComparer.OrdinalIgnoreCase)
    {
        ["1100"] = "1000",
        ["1900"] = "1000",
        ["2100"] = "2000"
    };

    private string? GetCompanyCode(string? displayPlant)
    {
        if (string.IsNullOrWhiteSpace(displayPlant))
            return null;

        return DisplayPlantToCompany.TryGetValue(displayPlant, out var companyCode)
            ? companyCode
            : displayPlant;
    }

    // ใช้กับ stock API โดยส่ง plant จริงจากหน้าจอ
    private string? GetStockApiPlantCode(string? displayPlant)
    {
        return string.IsNullOrWhiteSpace(displayPlant)
            ? null
            : displayPlant;
    }

    private static string? NormalizeMaterialForApi(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var trimmed = value.Trim();
        var firstSpace = trimmed.IndexOf(' ');

        return firstSpace > 0
            ? trimmed[..firstSpace]
            : trimmed;
    }

    private bool PlantMatches(string? itemPlant, string? selectedDisplayPlant)
    {
        if (string.IsNullOrWhiteSpace(selectedDisplayPlant))
            return true;

        if (string.IsNullOrWhiteSpace(itemPlant))
            return false;

        var companyCode = GetCompanyCode(selectedDisplayPlant);

        return itemPlant.Equals(selectedDisplayPlant, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(companyCode)
                && itemPlant.Equals(companyCode, StringComparison.OrdinalIgnoreCase));
    }


    private string? GetApiPlantCode(string? displayPlant)
    {
        if (string.IsNullOrWhiteSpace(displayPlant))
            return null;

        return DisplayPlantToCompany.TryGetValue(displayPlant, out var companyCode)
            ? companyCode
            : displayPlant;
    }

    private bool HideCostColumns
    {
        get
        {
            var userIsGreenLeaf = AuthState.CurrentCompanyID == 2;
            var selectedPlantIs2000 = string.Equals(GetCompanyCode(filters.Plant), "2000", StringComparison.OrdinalIgnoreCase);
            var cannotViewCost = AuthState.Permission?.CanViewCost == false;

            return userIsGreenLeaf || selectedPlantIs2000 || cannotViewCost;
        }
    }

    private int VisibleColumnCount => HideCostColumns ? 8 : 11;
