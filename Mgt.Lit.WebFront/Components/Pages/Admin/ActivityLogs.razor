@using Mgt.Lit.Core.DTOs.Admin
@using Microsoft.AspNetCore.Authorization
@using Mgt.Lit.Core.DTOs.Admin
@using Mgt.Lit.WebFront.Components.Layout.MainLay
@attribute [Authorize(Roles = "admin")]
@page "/admin/activity"
@layout AppLayout
@inject HttpClient Http

<h3>Activity Logs</h3>

<!-- 🔎 Filter Section -->
<div class="card p-3 mb-3">
    <div class="row">
        <div class="col-md-3">
            <label>Date From</label>
            <input type="date" class="form-control" @bind="filter.DateFrom" />
        </div>

        <div class="col-md-3">
            <label>Date To</label>
            <input type="date" class="form-control" @bind="filter.DateTo" />
        </div>

        <div class="col-md-3">
            <label>Username</label>
            <input type="text" class="form-control" @bind="filter.Username" />
        </div>

        <div class="col-md-3">
            <label>Status</label>
            <select class="form-control" @bind="filter.Status">
                <option value="">All</option>
                <option value="success">Success</option>
                <option value="fail">Fail</option>
            </select>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="LoadData">Search</button>
        <button class="btn btn-secondary ms-2" @onclick="ResetFilter">Reset</button>
    </div>
</div>

<!-- 📋 Table -->
<div class="card p-3">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>User</th>
                <th>API</th>
                <th>Status</th>
                <th>Time (ms)</th>
                <th>IP</th>
            </tr>
        </thead>
        <tbody>
            @if (logs == null)
            {
                <tr><td colspan="6">Loading...</td></tr>
            }
            else if (!logs.Any())
            {
                <tr><td colspan="6">No Data</td></tr>
            }
            else
            {
                @foreach (var log in logs)
                {
                    <tr>
                        <td>@log.CreateDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@log.Username</td>
                        <td>@log.Menu / @log.Page</td>
                        <td>
                            @if (log.IsSuccess)
                            {
                                <span class="badge bg-success">Success</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Fail</span>
                            }
                        </td>
                        <td>@log.ExecutionTimeMs</td>
                        <td>@log.IpAddress</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="d-flex justify-content-between">
        <button class="btn btn-sm btn-outline-primary"
                disabled="@(_page == 1)"
                @onclick="PreviousPage">
            Previous
        </button>

        <span>Page @_page</span>

        <button class="btn btn-sm btn-outline-primary"
                @onclick="NextPage">
            Next
        </button>
    </div>
</div>

@code {
    private List<ActivityLogDto> logs;
    private int _page = 1;
    private int _pageSize = 10;

    private ActivityFilterDto filter = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        filter.Page = _page;
        filter.PageSize = _pageSize;

        if (filter.Status == "success")
            filter.IsSuccess = true;
        else if (filter.Status == "fail")
            filter.IsSuccess = false;
        else
            filter.IsSuccess = null;

        var response = await Http.PostAsJsonAsync(
            "/api/admin/activity",
            filter);

        if (!response.IsSuccessStatusCode)
        {
            var txt = await response.Content.ReadAsStringAsync();
            Console.WriteLine(txt);
            return;
        }

        var result = await response.Content
            .ReadFromJsonAsync<PagedResult<ActivityLogDto>>();

        logs = result?.Items ?? new();
    }
    private async Task PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        _page++;
        await LoadData();
    }

    private async Task ResetFilter()
    {
        filter = new ActivityFilterDto();
        _page = 1;
        await LoadData();
    }

    public class ActivityLogDto
    {
        public string Username { get; set; }
        public string Menu { get; set; }
        public string Page { get; set; }
        public bool IsSuccess { get; set; }
        public int ExecutionTimeMs { get; set; }
        public string IpAddress { get; set; }
        public DateTime CreateDate { get; set; }
    }

    
}