    .um-modal-head { display: flex; align-items: center; gap: 14px; margin-bottom: 1.5rem; }
    .um-modal-icon { width: 46px; height: 46px; border-radius: 50%; background: #e8f5e9; color: #2e7d32;
                     display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    .um-input { border-radius: 15px !important; border: 1px solid #e2e8f0 !important; padding: 10px 15px !important; }
    .um-input:focus { border-color: #4caf50 !important; box-shadow: 0 0 0 .2rem rgba(76,175,80,.15) !important; }
    .um-hint { text-transform: none; letter-spacing: 0; font-weight: 500; color: #a0aec0; margin-left: 4px; }
