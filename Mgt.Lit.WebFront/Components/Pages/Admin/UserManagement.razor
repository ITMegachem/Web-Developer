@code {
    private List<AdminUserListItemDto>? _users;
    private AdminUserLookupsDto? _lookups;
    private string _search = "";
    private string _roleFilter = "";
    private string _statusFilter = "";
    private int _page = 1;
    private const int PageSize = 10;

    private bool _showCreate;
    private AdminCreateUserDto _form = new();
    private AdminUserListItemDto? _resetUser;
    private string _resetPassword = "";
    private string? _formError;
    private bool _saving;

    private string? _pageMessage;
    private string _pageMessageType = "success";

    private IEnumerable<AdminUserListItemDto> Filtered =>
        (_users ?? new()).Where(u =>
            (string.IsNullOrWhiteSpace(_search)
                || (u.Username ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (u.FullName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (u.Email ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))
            && (_roleFilter == "" || string.Equals(u.UserRole, _roleFilter, StringComparison.OrdinalIgnoreCase))
            && (_statusFilter == "" || (_statusFilter == "active") == u.IsActive));

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count() / (double)PageSize));
    private IEnumerable<AdminUserListItemDto> Paged =>
        Filtered.Skip((Math.Min(_page, TotalPages) - 1) * PageSize).Take(PageSize);
    private void ResetPage() => _page = 1;

    private static string Initials(AdminUserListItemDto u)
    {
        var src = string.IsNullOrWhiteSpace(u.FullName) ? (u.Username ?? "?") : u.FullName!;
        var parts = src.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var s = parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : src[..Math.Min(2, src.Length)];
        return s.ToUpperInvariant();
    }

    private bool IsAdmin => string.Equals(
        AuthState.User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "admin", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthState.InitializeAsync();
        if (!IsAdmin) { Nav.NavigateTo("/unauthorized", replace: true); return; }

        await LoadLookups();
        await LoadUsers();
        StateHasChanged();
    }

    private async Task LoadUsers()
    {
        try
        {
            var http = await Api.CreateAsync();
            _users = await http.GetFromJsonAsync<List<AdminUserListItemDto>>("api/admin/users") ?? new();
        }
        catch (Exception ex) { _users = new(); ShowPage("Could not load users: " + ex.Message, "danger"); }
    }

    private async Task LoadLookups()
    {
        try
        {
            var http = await Api.CreateAsync();
            _lookups = await http.GetFromJsonAsync<AdminUserLookupsDto>("api/admin/users/lookups");
        }
        catch (Exception ex) { ShowPage("Could not load companies/roles: " + ex.Message, "danger"); }
    }

    private void OpenCreate()
    {
        _form = new AdminCreateUserDto { UserRole = "user", IsActive = true };
        var first = _lookups?.Companies.FirstOrDefault();
        if (first != null) { _form.CompanyIDs.Add(first.CompanyID); _form.PrimaryCompanyID = first.CompanyID; }
        _formError = null;
        _showCreate = true;
    }

    private void ToggleCompany(int id, bool on)
    {
        if (on && !_form.CompanyIDs.Contains(id)) _form.CompanyIDs.Add(id);
        if (!on) _form.CompanyIDs.Remove(id);
        if (_form.PrimaryCompanyID == null || !_form.CompanyIDs.Contains(_form.PrimaryCompanyID.Value))
            _form.PrimaryCompanyID = _form.CompanyIDs.FirstOrDefault() is int f && f != 0 ? f : null;
    }

    private async Task SaveCreate()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_form.Username)) { _formError = "Username is required."; return; }
        if ((_form.Password ?? "").Length < 8) { _formError = "Password must be at least 8 characters."; return; }
        if (_form.CompanyIDs.Count == 0) { _formError = "Select at least one company."; return; }

        _saving = true;
        try
        {
            var http = await Api.CreateAsync();
            using var res = await http.PostAsJsonAsync("api/admin/users", _form);
            if (!res.IsSuccessStatusCode) { _formError = await ErrorText(res); return; }

            _showCreate = false;
            ShowPage($"User \"{_form.Username.Trim()}\" created.");
            await LoadUsers();
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private void OpenReset(AdminUserListItemDto u)
    {
        _resetUser = u;
        _resetPassword = "";
        _formError = null;
    }

    private async Task SaveReset()
    {
        if (_resetUser == null) return;
        _formError = null;
        if ((_resetPassword ?? "").Length < 8) { _formError = "Password must be at least 8 characters."; return; }

        _saving = true;
        try
        {
            var http = await Api.CreateAsync();
            using var res = await http.PostAsJsonAsync($"api/admin/users/{_resetUser.UserID}/reset-password",
                new AdminResetPasswordDto { NewPassword = _resetPassword });
            if (!res.IsSuccessStatusCode) { _formError = await ErrorText(res); return; }

            ShowPage($"Password of \"{_resetUser.Username}\" has been reset.");
            _resetUser = null;
            await LoadUsers();
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ToggleActive(AdminUserListItemDto u)
    {
        try
        {
            var http = await Api.CreateAsync();
            using var res = await http.PostAsync($"api/admin/users/{u.UserID}/active?value={(!u.IsActive).ToString().ToLower()}", null);
            if (!res.IsSuccessStatusCode) { ShowPage(await ErrorText(res), "danger"); return; }
            ShowPage($"\"{u.Username}\" is now {(u.IsActive ? "inactive" : "active")}.");
            await LoadUsers();
        }
        catch (Exception ex) { ShowPage(ex.Message, "danger"); }
    }

    private void ShowPage(string msg, string type = "success")
    {
        _pageMessage = msg;
        _pageMessageType = type;
    }

    private static async Task<string> ErrorText(HttpResponseMessage res)
    {
        var body = (await res.Content.ReadAsStringAsync()).Trim().Trim('"');
        if ((int)res.StatusCode == 401 || (int)res.StatusCode == 403) return "You don't have permission (admin only).";
        return string.IsNullOrWhiteSpace(body) ? $"Error {(int)res.StatusCode}" : body;
    }
}
