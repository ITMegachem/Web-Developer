@page "/admin/users"
@using Mgt.Lit.Core.DTOs.Admin
@using Mgt.Lit.WebFront.Components.Layout.MainLay
@using Mgt.Lit.WebFront.Services.Member
@layout AppLayout
@rendermode InteractiveServer
@inject ApiHttpClient Api
@inject Mgt.Lit.WebFront.Auth.AuthState AuthState
@inject NavigationManager Nav

<div class="so-page-wrapper um-page">
    @* --- Header --- *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <h2 class="page-title m-0">User Management</h2>
        <div class="d-flex align-items-center gap-2">
            <div class="date-badge">@DateTime.Now.ToString("dd MMM yyyy")</div>
            <button class="btn btn-search-pill px-4" @onclick="OpenCreate">
                <i class="bi bi-person-plus-fill me-1"></i> Add User
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_pageMessage))
    {
        <div class="um-toast um-toast-@_pageMessageType mb-3">
            <i class="bi @(_pageMessageType == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
            <span class="flex-grow-1">@_pageMessage</span>
            <button class="um-toast-close" @onclick="() => _pageMessage = null"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    @* --- Filters --- *@
    <div class="filter-card-modern shadow-sm mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="modern-label">Search</label>
                <input class="form-control modern-input" placeholder="Username, name or email"
                       @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="modern-label">Role</label>
                <select class="form-select modern-input" @bind="_roleFilter" @bind:after="ResetPage">
                    <option value="">All roles</option>
                    @foreach (var r in _lookups?.Roles ?? new())
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="modern-label">Status</label>
                <select class="form-select modern-input" @bind="_statusFilter" @bind:after="ResetPage">
                    <option value="">All</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
            <div class="col-12 col-lg-3 d-flex gap-3 justify-content-lg-end um-stats">
                <div><span class="um-stat-num">@(_users?.Count ?? 0)</span><span class="um-stat-lbl">Users</span></div>
                <div><span class="um-stat-num">@(_users?.Count(u => u.IsActive) ?? 0)</span><span class="um-stat-lbl">Active</span></div>
            </div>
        </div>
    </div>

    @* --- Table --- *@
    <div class="table-card-container shadow-sm">
        <div class="table-responsive">
            <table class="table modern-table fixed-table mb-0">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Division</th>
                        <th>Company</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_users == null)
                    {
                        <tr><td colspan="7" class="text-center py-5"><span class="spinner-border spinner-border-sm text-success me-2"></span>Loading…</td></tr>
                    }
                    else if (!Filtered.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">No users found</td></tr>
                    }
                    else
                    {
                        @foreach (var u in Paged)
                        {
                            <tr class="@(u.IsActive ? "" : "um-row-inactive")">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="um-avatar">@Initials(u)</div>
                                        <div>
                                            <div class="numeric-green">@u.Username</div>
                                            <div class="text-muted small">@(string.IsNullOrWhiteSpace(u.FullName) ? "-" : u.FullName)</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-nowrap">@(string.IsNullOrWhiteSpace(u.Email) ? "-" : u.Email)</td>
                                <td><span class="badge-pill-material um-role-@(u.UserRole?.ToLowerInvariant())">@u.UserRole</span></td>
                                <td>@(string.IsNullOrWhiteSpace(u.Division) ? "-" : u.Division)</td>
                                <td class="text-nowrap">
                                    @foreach (var c in u.CompanyCodes)
                                    {
                                        <span class="um-chip @(c == u.PrimaryCompanyCode ? "um-chip-primary" : "")" title="@(c == u.PrimaryCompanyCode ? "Primary company" : "")">@c</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <span class="um-status @(u.IsActive ? "on" : "off")">@(u.IsActive ? "Active" : "Inactive")</span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <button class="um-icon-btn" title="Reset password" @onclick="() => OpenReset(u)">
                                        <i class="bi bi-key-fill"></i>
                                    </button>
                                    <button class="um-icon-btn @(u.IsActive ? "danger" : "success")" title="@(u.IsActive ? "Deactivate" : "Activate")"
                                            @onclick="() => ToggleActive(u)">
                                        <i class="bi @(u.IsActive ? "bi-person-dash-fill" : "bi-person-check-fill")"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer-pagination">
            <div class="text-muted small">Results: @Filtered.Count()</div>
            <div class="d-flex align-items-center gap-3">
                <button class="pill-nav-btn" disabled="@(_page <= 1)" @onclick="() => _page--">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <div class="page-indicator"><span class="fw-bold text-success">@_page</span> / @TotalPages</div>
                <button class="pill-nav-btn" disabled="@(_page >= TotalPages)" @onclick="() => _page++">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@* ── Add user modal ── *@
@if (_showCreate)
{
    <div class="um-overlay">
        <div class="um-modal">
            <div class="um-modal-head">
                <div class="um-modal-icon"><i class="bi bi-person-plus-fill"></i></div>
                <div>
                    <h5 class="m-0 fw-bold">Add User</h5>
                    <div class="text-muted small">Create a new account</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="um-toast um-toast-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_formError</div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="modern-label">Username *</label>
                    <input class="form-control um-input" @bind="_form.Username" autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label class="modern-label">Password * <span class="um-hint">min 8</span></label>
                    <input class="form-control um-input" type="password" @bind="_form.Password" autocomplete="new-password" />
                </div>
                <div class="col-md-6">
                    <label class="modern-label">Full Name</label>
                    <input class="form-control um-input" @bind="_form.FullName" />
                </div>
                <div class="col-md-6">
                    <label class="modern-label">Email <span class="um-hint">for Microsoft sign-in</span></label>
                    <input class="form-control um-input" type="email" @bind="_form.Email" />
                </div>
                <div class="col-md-6">
                    <label class="modern-label">Role *</label>
                    <select class="form-select um-input" @bind="_form.UserRole">
                        @foreach (var r in _lookups?.Roles ?? new())
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="modern-label">Division</label>
                    <input class="form-control um-input" list="um-divisions" @bind="_form.Division" />
                    <datalist id="um-divisions">
                        @foreach (var d in _lookups?.Divisions ?? new())
                        {
                            <option value="@d"></option>
                        }
                    </datalist>
                </div>

                <div class="col-12">
                    <label class="modern-label">Companies * <span class="um-hint">choose the primary one</span></label>
                    <div class="um-companies">
                        @foreach (var c in _lookups?.Companies ?? new())
                        {
                            var picked = _form.CompanyIDs.Contains(c.CompanyID);
                            <div class="um-company @(picked ? "picked" : "")">
                                <label class="d-flex align-items-center gap-2 m-0 flex-grow-1">
                                    <input type="checkbox" class="form-check-input m-0" checked="@picked"
                                           @onchange="e => ToggleCompany(c.CompanyID, (bool)e.Value!)" />
                                    <span><b>@c.CompanyCode</b> <span class="text-muted">— @c.CompanyName</span></span>
                                </label>
                                @if (picked)
                                {
                                    <label class="um-primary-pick m-0">
                                        <input type="radio" name="um-primary" class="form-check-input m-0"
                                               checked="@(_form.PrimaryCompanyID == c.CompanyID)"
                                               @onchange="() => _form.PrimaryCompanyID = c.CompanyID" />
                                        Primary
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="um-active" @bind="_form.IsActive" />
                        <label class="form-check-label fw-semibold" for="um-active">Active</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn um-btn-ghost" @onclick="() => _showCreate = false" disabled="@_saving">Cancel</button>
                <button class="btn btn-search-pill px-4" @onclick="SaveCreate" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Create User
                </button>
            </div>
        </div>
    </div>
}

@* ── Reset password modal ── *@
@if (_resetUser != null)
{
    <div class="um-overlay">
        <div class="um-modal" style="max-width:440px">
            <div class="um-modal-head">
                <div class="um-modal-icon"><i class="bi bi-key-fill"></i></div>
                <div>
                    <h5 class="m-0 fw-bold">Reset Password</h5>
                    <div class="text-muted small">@_resetUser.Username will be signed out everywhere</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="um-toast um-toast-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_formError</div>
            }
            <label class="modern-label">New Password <span class="um-hint">min 8</span></label>
            <input class="form-control um-input" type="password" @bind="_resetPassword" autocomplete="new-password" />

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn um-btn-ghost" @onclick="() => _resetUser = null" disabled="@_saving">Cancel</button>
                <button class="btn btn-search-pill px-4" @onclick="SaveReset" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Reset
                </button>
            </div>
        </div>
    </div>
}

<style>
    .um-page .modern-table thead th { white-space: nowrap; }
    .um-page .modern-table tbody td { padding: 14px 16px; }
    .um-row-inactive td { opacity: .55; }

    .um-avatar { width: 38px; height: 38px; border-radius: 50%; background: #e8f5e9; color: #2e7d32;
                 display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: .8rem; flex-shrink: 0; }

    .um-chip { display: inline-block; padding: 3px 10px; border-radius: 10px; background: #f1f5f9; color: #4a5568;
               font-weight: 700; font-size: .72rem; margin-right: 4px; }
    .um-chip-primary { background: #4caf50; color: #fff; }

    .um-role-admin { background: #e8f5e9 !important; color: #1b5e20 !important; }
    .um-role-manager { background: #e3f2fd !important; color: #1565c0 !important; }
    .um-role-leader { background: #fff8e1 !important; color: #8d6e00 !important; }

    .um-status { display: inline-block; padding: 4px 12px; border-radius: 50px; font-weight: 700; font-size: .72rem; }
    .um-status.on { background: #e8f5e9; color: #2e7d32; }
    .um-status.off { background: #f1f5f9; color: #718096; }
    .um-status.warn { background: #fff8e1; color: #8d6e00; }

    .um-icon-btn { border: none; background: #fff; width: 36px; height: 36px; border-radius: 50%; color: #2e7d32;
                   box-shadow: 0 2px 8px rgba(0,0,0,.06); transition: all .2s; margin-left: 4px; }
    .um-icon-btn:hover { background: #e8f5e9; transform: translateY(-2px); }
    .um-icon-btn.danger { color: #c62828; }
    .um-icon-btn.danger:hover { background: #ffebee; }
    .um-icon-btn.success:hover { background: #e8f5e9; }

    .um-stats > div { display: flex; flex-direction: column; align-items: center; background: #fff; border-radius: 18px; padding: 6px 18px; }
    .um-stat-num { font-weight: 800; font-size: 1.2rem; color: #1b5e20; line-height: 1.2; }
    .um-stat-lbl { font-size: .7rem; font-weight: 700; color: #718096; text-transform: uppercase; letter-spacing: .05em; }

    .um-toast { display: flex; align-items: center; padding: 12px 18px; border-radius: 18px; font-weight: 600; }
    .um-toast-success { background: #e8f5e9; color: #1b5e20; }
    .um-toast-danger { background: #ffebee; color: #b71c1c; }
    .um-toast-close { border: none; background: transparent; color: inherit; opacity: .6; }
    .um-toast-close:hover { opacity: 1; }

    .um-overlay { position: fixed; inset: 0; background: rgba(15,23,42,.45); backdrop-filter: blur(2px); z-index: 2000;
                  display: flex; align-items: center; justify-content: center; padding: 16px; }
    .um-modal { font-family: 'Inter','Sarabun',sans-serif; font-size: 90%; background: #fff; border-radius: 28px; padding: 2rem;
