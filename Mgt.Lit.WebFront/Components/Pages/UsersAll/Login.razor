@page "/"
@* ใช้ Layout เป็น LoginLayout เฉพาะตอนยังไม่ได้ Login *@
@layout LoginLayout
<link rel="stylesheet" href="/lib/bootstrap/dist/css/siteLogin.css" />
<style>
    .remember-me-row {
        margin-bottom: 18px;
        margin-top: -6px;
    }

    .remember-me-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.88rem;
        color: #4b5563;
        cursor: pointer;
        user-select: none;
        width: fit-content;
    }

    .remember-me-label input[type="checkbox"] {
        width: 16px;
        height: 16px;
        accent-color: #16a34a;
        cursor: pointer;
    }
</style>

@inject AuthService Auth
@using Mgt.Lit.WebFront.Components.Layout.Data
@using Mgt.Lit.WebFront.Services
@using Mgt.Lit.WebFront.Services.Member
@inject Mgt.Lit.WebFront.Auth.AuthState AuthState
@using Microsoft.JSInterop
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt
@inject IJSRuntime JS
@inject NavigationManager Nav
@if (!_isInitialized)
{
    <div class="init-loader">
        <div class="init-ring"></div>
    </div>
}
else
{
    <div class="login-bg">
        <div class="login-card">
            <div class="login-card-inner">

                <!-- Left: MGT Logo -->
                <div class="login-left">
                    <div class="logo-stack">
                        <img src="images/mgt-logo.png" class="mgt-logo" alt="MGT Logo">
                    </div>
                </div>

                <!-- Right: Form -->
                <div class="login-right">
                    <div class="login-eyebrow">MGT Business Intelligence</div>
                    <div class="login-title">
                        Welcome<br><span class="login-title-em">back.</span>
                    </div>
                    <div class="login-sub">Sign in to continue</div>

                    @if (showAlert)
                    {
                        <div class="alert-box">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8" x2="12" y2="12" />
                                <line x1="12" y1="16" x2="12.01" y2="16" />
                            </svg>
                            <span>@alertMessage</span>
                            <button class="alert-close" @onclick="() => showAlert = false">✕</button>
                        </div>
                    }
                    
                    <div class="field-block">
                        <label class="form-label">Username</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <circle cx="12" cy="8" r="4" />
                                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
                                </svg>
                            </span>
                            <input class="form-control" placeholder="Enter username" @bind="username" autocomplete="username" />
                        </div>
                    </div>

                    <div class="field-block">
                        <label class="form-label">Password</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                            </span>
                            <input class="form-control"
                                   type="@(showPassword ? "text" : "password")"
                                   placeholder="Enter password"
                                   @bind="password"
                                   @onkeyup="HandleKeyUp"
                                   autocomplete="current-password"
                                   style="padding-right:48px;" />
                            <button class="eye-btn" type="button" @onclick="() => showPassword = !showPassword" tabindex="-1">
                                @if (showPassword)
                                {
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                        <line x1="1" y1="1" x2="23" y2="23" />
                                    </svg>
                                }
                                else
                                {
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                }
                            </button>
                        </div>
                    </div>

                    <div class="remember-me-row">
                        <label class="remember-me-label">
                            <input type="checkbox" @bind="rememberMe" />
                            <span>Remember me</span>
                        </label>
                    </div>

                     <div class="btn-wrap">
                        <button class="btn-login" @onclick="DoLogin" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spin-ring"></span>
                                <span>Signing in…</span>
                            }
                            else
                            {
                                <span>Login</span>
                            }
                        </button>
                    </div>
                   
                    <div class="divider-wrap">
                        <span class="divider-line"></span>
                        <span class="divider-text">or</span>
                        <span class="divider-line"></span>
                    </div> 

                    <div class="btn-wrap">
                        <button class="btn-microsoft" @onclick="LoginWithMicrosoft" disabled="@isLoading">
                            <svg width="18" height="18" viewBox="0 0 21 21" fill="none">
                                <rect x="1" y="1" width="9" height="9" fill="#F25022" />
                                <rect x="11" y="1" width="9" height="9" fill="#7FBA00" />
                                <rect x="1" y="11" width="9" height="9" fill="#00A4EF" />
                                <rect x="11" y="11" width="9" height="9" fill="#FFB900" />
                            </svg>
                            <span>Sign in with Microsoft</span>
                        </button>
                    </div>
                    
                    <div class="forgot-password">
                        @*<a href="#">Forgotten password?</a>*@
                    </div>
                </div>

            </div>
        </div>
    </div>
}

@code {
    string username = "";
    string password = "";
    bool rememberMe = false;
    bool isLoading = false;
    bool showAlert = false;
    bool showPassword = false;
    string alertType = "success";
    string alertMessage = "";
    bool _isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthState.InitializeAsync();
        _isInitialized = true;
        StateHasChanged();
        if (!string.IsNullOrEmpty(AuthState.Token))
            Nav.NavigateTo("/Main", forceLoad: true);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }

    async Task DoLogin()
    {
        try
        {
            showAlert = false;
            isLoading = true;

            var result = await Auth.LoginAsync(new()
            {
                Username = username,
                Password = password
            }, rememberMe);

            if (result == null)
            {
                alertType = "danger";
                alertMessage = "Username หรือ Password ไม่ถูกต้อง";
                showAlert = true;
                return;
            }

            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(result.Token);
            var claims = jwt.Claims.ToList();

            claims.Add(new Claim("FullName", result.FullName ?? ""));
            claims.Add(new Claim("CompanyID", result.PrimaryCompanyID?.ToString() ?? "0"));
            claims.Add(new Claim("CompanyCode", result.PrimaryCompanyCode ?? ""));

            foreach (var c in result.Companies)
            {
                claims.Add(new Claim("Company", c.CompanyCode));
                claims.Add(new Claim("CompanyIDAllowed", c.CompanyID.ToString()));
            }

            if (result.Permission is not null)
            {
                claims.Add(new Claim("RoleKey", result.Permission.RoleKey ?? ""));
                claims.Add(new Claim("Tier", result.Permission.Tier ?? ""));
                claims.Add(new Claim("Page1Access", result.Permission.Page1Access.ToString()));
                claims.Add(new Claim("Page2Access", result.Permission.Page2Access.ToString()));
                claims.Add(new Claim("Page3Access", result.Permission.Page3Access.ToString()));
                claims.Add(new Claim("DataScope", result.Permission.DataScope ?? ""));
                claims.Add(new Claim("CanViewVendor", result.Permission.CanViewVendor.ToString()));
                claims.Add(new Claim("CanViewCost", result.Permission.CanViewCost.ToString()));
            }

            AuthState.Token = result.Token;
            AuthState.User = new ClaimsPrincipal(new ClaimsIdentity(claims, "jwt"));
            AuthState.ExportPassword = password;
            await JS.InvokeVoidAsync("sessionStorage.setItem", "ep", password);
            Nav.NavigateTo("/Main", forceLoad: true);
        }
        catch (Exception ex)
        {
            alertType = "danger";
            alertMessage = ex.Message;
            showAlert = true;
        }
        finally
        {
            isLoading = false;
        }
    }
    async Task LoginWithMicrosoft()
    {
        try
        {
            isLoading = true;
            var response = await Auth.GetMicrosoftLoginUrlAsync();
            if (!string.IsNullOrEmpty(response))
                Nav.NavigateTo(response, forceLoad: true);
        }
        catch (Exception ex)
        {
            alertMessage = ex.Message;
            showAlert = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}
