<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <title>MGT - DASHBOARDS</title>
    <link rel="stylesheet" href="@Assets["Mgt.Lit.WebFront.styles.css"]" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/MainLayout/app-layout.css" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/MainLayout/sidebar.css" />
    <ImportMap />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link href="_content/Blazorise/blazorise.css" rel="stylesheet" />
    <link href="_content/Blazorise.Bootstrap5/blazorise.bootstrap5.css" rel="stylesheet" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/sales.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/litepicker/dist/css/litepicker.css" />
    <HeadOutlet />
    <style>
            #components-reconnect-modal {
                display: none !important;
            }
    </style>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/litepicker/dist/bundle.js"></script>

    <!-- ✅ เพิ่มตรงนี้ — ต้องอยู่หลัง blazor.web.js -->
    <script>
        Blazor.start({
        circuit: {
        reconnectionOptions: {
        maxRetries: 10,
        retryIntervalMilliseconds: 3000
        }
        }
        });
    </script>
</body>
</html>